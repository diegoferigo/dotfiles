{
  "allowedUrls": [],
  "disabledSkills": [],
  "effortLevel": "low",
  "experimental": true,
  "footer": {
    "showModelEffort": true,
    "showDirectory": true,
    "showBranch": true,
    "showContextWindow": true,
    "showQuota": false,
    "showAiUsed": true,
    "showAgent": true,
    "showCodeChanges": false,
    "showUsername": false,
    "showSandbox": true,
    "showCiStatus": false,
    "showSchedules": true,
    "showPullRequest": true,
    "showCustom": true
  },
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "bash \"$HOME/.copilot/hooks/herdr-agent-state.sh\"",
        "timeoutSec": 10,
        "_vsCodeCompat": "SessionStart"
      }
    ]
  },
  "keepAlive": "busy",
  "model": "claude-sonnet-5.5",
  "subagents": {
    "agents": {
      "research": {
        "model": "claude-sonnet-5.5",
        "effortLevel": "medium",
        "contextTier": "default"
      },
      "rubber-duck": {
        "autoInvoke": true
      }
    }
  },
  "voice": {
    "enabled": false
  },
  "worktreeBaseRef": "defaultBranch",
  "worktreePathTemplate": "{repoPath}/.worktrees/{branchSlug}"
}
