      {
        "type": "command",
        "timeoutSec": 30,
        "bash": "\"$HOME/.copilot/hooks/herdr-session-title.py\""
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "timeoutSec": 30,
        "bash": "\"$HOME/.copilot/hooks/herdr-session-title.py\""
      }
