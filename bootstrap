#!/usr/bin/env bash
set -euo pipefail

# ===========================
# Bootstrap the Python script
# ===========================

readonly GH_USER="${GITHUB_USER:-diegoferigo}"
readonly GH_REPO="${GITHUB_REPO:-dotfiles}"
readonly GH_BRANCH="${GITHUB_BRANCH:-main}"
readonly GH_REPO_RAW="https://raw.githubusercontent.com/${GH_USER}/${GH_REPO}/${GH_BRANCH}"

# Determine the directory of this script (could be /dev/fd if run from stdin).
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly script_dir

# Create a temporary directory for downloaded files, and ensure it's cleaned up on exit.
tmpdir=""
function cleanup() {
    [[ -n "${tmpdir}" && -d "${tmpdir}" ]] && rm -rf "${tmpdir}"
}
trap cleanup EXIT

# Use a local dotfiles script if available (running from a cloned repo),
# otherwise download it from GitHub.
readonly local_bootstrap="${script_dir}/.local/bin/dotfiles"
if [[ -f "${local_bootstrap}" && -d "${script_dir}/.git" && "${script_dir}" != "/dev/fd" ]]; then
    readonly bootstrap="${local_bootstrap}"
    readonly dotfiles_repo_uri="file://${script_dir}"
    echo "==> Using local .local/bin/dotfiles"
else
    echo "==> Downloading dotfiles script from GitHub..."
    tmpdir="$(mktemp -d)"
    curl -fsSL "${GH_REPO_RAW}/.local/bin/dotfiles" >"${tmpdir}/dotfiles"
    chmod +x "${tmpdir}/dotfiles"
    readonly bootstrap="${tmpdir}/dotfiles"
    readonly dotfiles_repo_uri="https://github.com/${GH_USER}/${GH_REPO}.git"
fi

# ========================
# Bootstrap pixi if needed
# ========================

# If the PATH is not already set to include pixi, add it temporarily.
if ! command -v pixi &>/dev/null; then
    if [[ -x $HOME/.pixi/bin/pixi ]]; then
        export PATH="$HOME/.pixi/bin:$PATH"
    fi
fi

# Update pixi if explicitly requested (PIXI_UPDATE=1).
if [[ "${PIXI_UPDATE:-0}" == "1" ]] && command -v pixi &>/dev/null; then
    pixi self-update
fi

# Install pixi if not already installed.
if ! command -v pixi &>/dev/null; then
    echo "Pixi not found. Installing pixi..."
    if command -v curl &>/dev/null; then
        curl -fsSL https://pixi.sh/install.sh | bash
    elif command -v wget &>/dev/null; then
        wget -qO- https://pixi.sh/install.sh | bash
    else
        echo "ERROR: Neither curl nor wget found. Cannot install pixi."
        exit 1
    fi
    export PATH="$HOME/.pixi/bin:$PATH"
    if ! command -v pixi &>/dev/null; then
        echo "ERROR: Could not find pixi after installation, something failed."
        exit 1
    fi
    echo "... done!"
fi

# ==========================
# Run bootstrap.py with pixi
# ==========================

# Run the dotfiles script.
# This file has a shebang that points to pixi.
# It creates a temporary pixi environment with the required dependencies to run the script.
exec "$bootstrap" --repo-uri "$dotfiles_repo_uri" "$@"
