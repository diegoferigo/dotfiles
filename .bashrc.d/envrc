#!/bin/bash

[[ -n $(type -t nano) ]] && export EDITOR="nano"

# Use the user ssh-agent service (.config/systemd/user) when the inherited agent
# is missing or dead: a long-lived process such as herdr keeps a stale
# SSH_AUTH_SOCK. `ssh-add -l` exits 2 when it cannot reach an agent.
_ssh_agent_socket=${XDG_RUNTIME_DIR:-/run/user/$UID}/ssh-agent-user.socket
if [[ -S $_ssh_agent_socket && -n $(type -t ssh-add) ]]; then
    _ssh_add_status=0
    ssh-add -l &>/dev/null || _ssh_add_status=$?
    [[ $_ssh_add_status -eq 2 ]] && export SSH_AUTH_SOCK=$_ssh_agent_socket
    unset _ssh_add_status
fi
unset _ssh_agent_socket

# Disable __pycache__ / .pyc artifacts.
export PYTHONDONTWRITEBYTECODE=1

# Nicer paging: keep colors and quit if the output fits one screen.
export LESS='-RF'

# Use bat as the man pager when available.
[[ -n $(type -t bat) ]] && export MANPAGER="sh -c 'col -bx | bat -l man -p'"

# Use difftastic for structural git diffs when available.
[[ -n $(type -t difft) ]] && export GIT_EXTERNAL_DIFF=difft

# Load the ROS environment
if [[ -f /opt/ros/"$ROS_DISTRO"/setup.bash ]] ; then
    old_path=$ROS_PACKAGE_PATH
    source /opt/ros/"$ROS_DISTRO"/setup.bash
    ROS_PACKAGE_PATH=$ROS_PACKAGE_PATH:$old_path
    unset old_path
fi

# Load the gazebo environment
if [[ -f /usr/share/gazebo/setup.sh ]] ; then
    source /usr/share/gazebo/setup.sh
fi
