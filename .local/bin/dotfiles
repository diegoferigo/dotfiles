# =========
# Utilities
# =========


def describe_error(exc: BaseException) -> str:
    """Return a descriptive message for exc.

    A subprocess.CalledProcessError stringifies to just the command and the
    exit code, dropping the captured output. With capture_output=True that
    hides the actual git message and leaves a useless 'returned non-zero exit
    status 128'. Unpack it so the real stderr (and stdout) reach the user.
    """

    if not isinstance(exc, subprocess.CalledProcessError):
        return str(exc)

    def _clean(stream: object) -> str:
        """Normalize one captured subprocess stream for display."""

        if not stream:
            return ""
        text = (
            stream.decode(errors="replace")
            if isinstance(stream, bytes)
            else str(stream)
        )
        return text.strip()

    argv = exc.cmd
    cmd = " ".join(argv) if isinstance(argv, (list, tuple)) else str(argv)
    lines = [f"Command failed (exit {exc.returncode}): {cmd}"]
    stderr = _clean(exc.stderr)
    stdout = _clean(exc.stdout)
    if stderr:
        lines.append(stderr)
    if stdout:
        lines.append(stdout)

    return "\n".join(lines)


class Bashrc:
    """Namespace for ~/.bashrc injection operations."""

    BLOCK_BEGIN = "# >>> dotfiles >>>"
    BLOCK_END = "# <<< dotfiles <<<"
    DOTFILES_FILE = ".bashrc.dotfiles.sh"
    ENVIRONMENT_BLOCK_BEGIN = "# >>> dotfiles environment >>>"
    ENVIRONMENT_BLOCK_END = "# <<< dotfiles environment <<<"
    ENVIRONMENT_FILE = ".bashrc.environment.sh"

    @staticmethod
    def _read_embedded_block(
        home: pathlib.Path,
        source_file: str,
        begin: str,
        end: str,
    ) -> str:
        """Build one managed block from a tracked Bash source file."""

        source = home / source_file
        if not source.exists():
            raise RuntimeError(f"Source file not found: {source}")

        content = source.read_text(encoding="utf-8").rstrip("\n")

        return (
            f"{begin}\n"
            f"# AUTO-GENERATED — edit ~/{source_file} and run 'dotfiles --update'\n"
            f"{content}\n"
            f"{end}"
        )

    @classmethod
    def _read_environment_block(cls, home: pathlib.Path) -> str:
        """Build the prepended block that sources the environment payload."""

        source = home / cls.ENVIRONMENT_FILE
        if not source.exists():
            raise RuntimeError(f"Source file not found: {source}")

        return (
            f"{cls.ENVIRONMENT_BLOCK_BEGIN}\n"
            f"# AUTO-GENERATED - edit ~/{cls.ENVIRONMENT_FILE} and run 'dotfiles --update'\n"
            f"[[ -f ~/{cls.ENVIRONMENT_FILE} ]] && source ~/{cls.ENVIRONMENT_FILE}\n"
            f"{cls.ENVIRONMENT_BLOCK_END}"
        )

    @classmethod
    def read_blocks(cls, home: pathlib.Path) -> tuple[str, str]:
        """Build the environment and interactive managed blocks."""

        return (
            cls._read_environment_block(home),
            cls._read_embedded_block(
                home,
                cls.DOTFILES_FILE,
                cls.BLOCK_BEGIN,
                cls.BLOCK_END,
            ),
        )

    @staticmethod
    def _inject_block(
        text: str,
        block: str,
        begin: str,
        end: str,
        *,
        prepend: bool,
    ) -> str:
        """Replace one managed block or insert it at the requested boundary."""

        pattern = rf"{re.escape(begin)}.*?{re.escape(end)}"
        new_text, n = re.subn(pattern, lambda _: block, text, flags=re.DOTALL)
        if n:
            return new_text
        if prepend:
            return f"{block}\n{text}"
        separator = "" if not text or text.endswith("\n") else "\n"
        return f"{text}{separator}{block}\n"

    @classmethod
    def inject(
        cls,
        home: pathlib.Path,
        environment_block: str,
        interactive_block: str,
    ) -> None:
        """Inject or update both managed blocks in ~/.bashrc."""

        bashrc = home / ".bashrc"
        text = bashrc.read_text(encoding="utf-8") if bashrc.exists() else ""
        text = cls._inject_block(
            text,
            environment_block,
            cls.ENVIRONMENT_BLOCK_BEGIN,
            cls.ENVIRONMENT_BLOCK_END,
            prepend=True,
        )
        text = cls._inject_block(
            text,
            interactive_block,
            cls.BLOCK_BEGIN,
            cls.BLOCK_END,
            prepend=False,
        )
        bashrc.write_text(text, encoding="utf-8")

    @staticmethod
    def _remove_block(text: str, begin: str, end: str) -> str:
        """Remove one managed block while preserving surrounding content."""

        pattern = rf"{re.escape(begin)}.*?{re.escape(end)}"
        match = re.search(pattern, text, flags=re.DOTALL)

        if match is None:
            return text

        # Keep one newline boundary when removing the managed block.
        # This avoids merging neighboring lines.
        # This also avoids leaving a doubled blank line at EOF.
        before = text[: match.start()].rstrip("\n")
        after = text[match.end() :].lstrip("\n")

        new_text = f"{before}\n{after}" if before and after else before + after

        if new_text and not new_text.endswith("\n"):
            new_text += "\n"

        return new_text

    @classmethod
    def remove_blocks(
        cls,
        home: pathlib.Path,
    ) -> None:
        """Remove both managed blocks from ~/.bashrc, if present."""

        bashrc = home / ".bashrc"
        if not bashrc.exists():
            return

        text = bashrc.read_text(encoding="utf-8")
        text = cls._remove_block(
            text,
            cls.ENVIRONMENT_BLOCK_BEGIN,
            cls.ENVIRONMENT_BLOCK_END,
        )
        text = cls._remove_block(text, cls.BLOCK_BEGIN, cls.BLOCK_END)
        bashrc.write_text(text, encoding="utf-8")


def require_command(name: str) -> None:
    """Raise SystemExit if the named executable is not found on PATH."""

    if shutil.which(name) is None:
        err_console.print(f"[red]==> command not found: {name}[/red]")
        raise SystemExit(1)


def find_pixi() -> pathlib.Path:
    """Return the pixi binary path, checking ~/.pixi/bin first then PATH."""

    candidate = pathlib.Path.home() / ".pixi" / "bin" / "pixi"

    if candidate.is_file() and os.access(candidate, os.X_OK):
        return candidate

    found = shutil.which("pixi")

    if found:
        return pathlib.Path(found)

    raise RuntimeError("pixi binary not found; cannot install tools")


def find_age() -> pathlib.Path | None:
    """Return the age binary path, checking ~/.pixi/bin first then PATH."""

    candidate = pathlib.Path.home() / ".pixi" / "bin" / "age"
    if candidate.is_file() and os.access(candidate, os.X_OK):
        return candidate

    found = shutil.which("age")
    return pathlib.Path(found) if found else None


def find_age_keygen(age: pathlib.Path) -> pathlib.Path | None:
    """Return age-keygen next to age or from PATH."""

    candidate = age.with_name("age-keygen")
    if candidate.is_file() and os.access(candidate, os.X_OK):
        return candidate

    found = shutil.which("age-keygen")
    return pathlib.Path(found) if found else None


def installed_tools(pixi: pathlib.Path) -> set[str]:
    """Names of the pixi global environments, or an empty set when they cannot be listed."""

    result = subprocess.run(
        [str(pixi), "global", "list", "--json"],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        return set()
    try:
        return {environment["name"] for environment in json.loads(result.stdout)}
    except (ValueError, TypeError, KeyError):
        return set()


def install_tools(
    pixi: pathlib.Path,
) -> None:
    """Install each tool in TOOLS via pixi global, skipping the ones already installed."""

    console.print("==> Installing tools via pixi global")
    installed = installed_tools(pixi)
    for tool in TOOLS:
        if tool in installed:
            console.print(f"    · {tool} (installed)")
            continue
        console.print(f"    · {tool}")
        result = subprocess.run(
            [str(pixi), "global", "install", tool],
            capture_output=True,
            text=True,
        )
        if result.returncode != 0:
            raise RuntimeError(f"Failed to install '{tool}':\n{result.stderr}")


def install_tools_or_warn(skip: bool) -> None:
    """Run install_tools() without ever failing the caller.

    Runs after the dotfiles are installed or updated: leaving (or omitting) pixi
    global packages is harmless, so a transient tool-install failure must not
    roll back or fail a successful install or update.
    """

    if skip:
        console.print("==> Skipping tool installation (--skip-tools)")
        return
    try:
        install_tools(pixi=find_pixi())
    except Exception as exc:
        err_console.print(
            f"\n[yellow]==> Tool installation failed (dotfiles are still in place): {describe_error(exc)}[/yellow]"
        )
        err_console.print(
            "[yellow]==> Re-run to retry, or install the tools manually via pixi global.[/yellow]"
        )


LAZY_TOOLS_SCRIPT = pathlib.Path(".local/libexec/dotfiles/lazy-tools")
HERDR_SETUP_SCRIPT = pathlib.Path(".local/libexec/dotfiles/herdr-setup.sh")


def install_lazy_tools(home: pathlib.Path) -> None:
    """Run the tracked lazy-tools script for the tools that pixi cannot provide."""

    _run_libexec_script(
        home / LAZY_TOOLS_SCRIPT, "install", heading="Installing tools outside pixi"
    )


def install_lazy_tools_or_warn(skip: bool, home: pathlib.Path) -> None:
    """Run install_lazy_tools() without ever failing the caller, like install_tools_or_warn()."""

    if skip:
        return
    try:
        install_lazy_tools(home)
    except Exception as exc:
        err_console.print(
            f"\n[yellow]==> Installing tools outside pixi failed (dotfiles are still in place): {describe_error(exc)}[/yellow]"
        )
        err_console.print(
            f"[yellow]==> Re-run to retry, or run {home / LAZY_TOOLS_SCRIPT} install.[/yellow]"
        )


def setup_herdr(home: pathlib.Path) -> None:
    """Run the tracked herdr-setup script: the Copilot hook and the agent skill of herdr."""

    _run_libexec_script(home / HERDR_SETUP_SCRIPT, heading="Setting up herdr")


def setup_herdr_or_warn(skip: bool, home: pathlib.Path) -> None:
    """Run setup_herdr() without ever failing the caller, like install_lazy_tools_or_warn()."""

    if skip:
        return
    try:
        setup_herdr(home)
    except Exception as exc:
        err_console.print(
            f"\n[yellow]==> Setting up herdr failed (dotfiles are still in place): {describe_error(exc)}[/yellow]"
        )
        err_console.print(f"[yellow]==> Re-run to retry, or run {home / HERDR_SETUP_SCRIPT}.[/yellow]")


def _run_libexec_script(script: pathlib.Path, *args: str, heading: str) -> None:
    """Run a tracked libexec script, print its output and raise on a non-zero exit status."""

    if not script.is_file():
        return

    console.print(f"==> {heading}")
    result = subprocess.run(
        [str(script), *args],
        capture_output=True,
        text=True,
        timeout=600,
    )
    if result.stdout:
        console.print(result.stdout.rstrip(), markup=False, highlight=False)
    if result.returncode != 0:
        raise RuntimeError(f"{script.name} failed:\n{result.stderr}")
    if result.stderr:
        err_console.print(result.stderr.rstrip(), markup=False, highlight=False)


# ==================
# Encrypted dotfiles
# ==================


SECRETS_PREFIX = pathlib.PurePosixPath("secrets/home")
AGE_IDENTITY = pathlib.Path(".config/dotfiles/age/identity.txt")
AGE_ENCRYPTED_IDENTITY = pathlib.Path(".config/dotfiles/age/identity.txt.age")
AGE_RECIPIENTS = pathlib.Path(".config/dotfiles/age/recipients.txt")


@dataclasses.dataclass(frozen=True)
class SecretSpec:
    """An encrypted Git blob and its deterministic target below HOME."""

    source: pathlib.PurePosixPath
    target: pathlib.Path
    source_blob: str


def _git_bytes(
    dotfiles_dir: pathlib.Path,
    *args: str,
) -> bytes:
    """Run a read-only Git command against the bare repo and return stdout."""

    return subprocess.run(
        ["git", "--git-dir", str(dotfiles_dir), *args],
        check=True,
        capture_output=True,
    ).stdout


def _secret_target(
    source: pathlib.PurePosixPath,
    home: pathlib.Path,
    dotfiles_dir: pathlib.Path,
    backup_dir: pathlib.Path,
) -> pathlib.Path:
    """Map a secrets/home/<path>.age source to a safe target below home."""

    try:
        relative = source.relative_to(SECRETS_PREFIX)
    except ValueError as exc:
        raise ValueError(
            f"Encrypted source is outside {SECRETS_PREFIX}: {source}"
        ) from exc

    if (
        source.suffix != ".age"
        or not relative.parts
        or relative == pathlib.PurePosixPath(".age")
        or ".." in relative.parts
    ):
        raise ValueError(f"Invalid encrypted source path: {source}")

    plaintext = pathlib.Path(*relative.parts).with_suffix("")
    target = home / plaintext
    home_resolved = home.resolve()
    target_resolved = target.resolve(strict=False)
    if not target_resolved.is_relative_to(home_resolved):
        raise ValueError(f"Encrypted target escapes HOME: {target}")
    for path in (target, *target.parents):
        if path == home:
            break
        if path.is_symlink():
            raise ValueError(f"Encrypted target crosses a symlink: {target}")

    internal_paths = (dotfiles_dir.resolve(), backup_dir.resolve())
    if any(
        target_resolved == internal or target_resolved.is_relative_to(internal)
        for internal in internal_paths
    ):
        raise ValueError(f"Encrypted target overlaps dotfiles state: {target}")
    identity_paths = (
        (home / AGE_IDENTITY).resolve(strict=False),
        (home / AGE_ENCRYPTED_IDENTITY).resolve(strict=False),
        (home / AGE_RECIPIENTS).resolve(strict=False),
    )
    if target_resolved in identity_paths:
        raise ValueError(f"Encrypted target overlaps age identity metadata: {target}")
    return target


def _secret_sources(dotfiles_dir: pathlib.Path) -> list[pathlib.PurePosixPath]:
    """List encrypted source paths in HEAD."""

    listing = _git_bytes(
        dotfiles_dir,
        "ls-tree",
        "-r",
        "-z",
        "--name-only",
        "HEAD",
        "--",
        str(SECRETS_PREFIX),
    )
    return sorted(
        (
            pathlib.PurePosixPath(raw.decode("utf-8"))
            for raw in listing.split(b"\0")
            if raw and raw.decode("utf-8").endswith(".age")
        ),
        key=str,
    )


def discover_secrets(
    dotfiles_dir: pathlib.Path,
    home: pathlib.Path,
    backup_dir: pathlib.Path,
) -> list[SecretSpec]:
    """Discover encrypted files in HEAD without checking them out into HOME."""

    specs: list[SecretSpec] = []
    for source in _secret_sources(dotfiles_dir):
        target = _secret_target(source, home, dotfiles_dir, backup_dir)
        source_blob = (
            _git_bytes(dotfiles_dir, "rev-parse", f"HEAD:{source}")
            .decode("ascii")
            .strip()
        )
        specs.append(SecretSpec(source, target, source_blob))
    return sorted(specs, key=lambda spec: str(spec.source))


def _read_manifest(dotfiles_dir: pathlib.Path) -> dict[str, object]:
    """Read manifest.json, returning an empty manifest when it does not exist."""

    path = dotfiles_dir / "manifest.json"
    if not path.exists():
        return {}
    data = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(data, dict):
        raise RuntimeError(f"Invalid manifest: {path}")
    return data


def _write_manifest_data(
    dotfiles_dir: pathlib.Path,
    manifest: dict[str, object],
) -> None:
    """Write manifest.json atomically."""

    path = dotfiles_dir / "manifest.json"
    fd, tmp_name = tempfile.mkstemp(prefix="manifest.", dir=dotfiles_dir)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            json.dump(manifest, stream, indent=2)
            stream.write("\n")
        pathlib.Path(tmp_name).replace(path)
    except BaseException:
        pathlib.Path(tmp_name).unlink(missing_ok=True)
        raise


def _sha256(content: bytes) -> str:
    """Return the SHA-256 hex digest for content."""

    return hashlib.sha256(content).hexdigest()


def _same_content(a: pathlib.Path, b: pathlib.Path) -> bool:
    """Whether a and b are regular files (not symlinks) with equal bytes.

    An unreadable file is reported as different rather than raising.
    """

    try:
        return all(p.is_file() and not p.is_symlink() for p in (a, b)) and (
            a.read_bytes() == b.read_bytes()
        )
    except OSError:
        return False


def _identity_status(home: pathlib.Path) -> tuple[pathlib.Path, str | None]:
    """Return the age identity path and an error when it is unavailable or unsafe."""

    identity = home / AGE_IDENTITY
    if identity.is_symlink():
        return identity, "must be a regular file, not a symlink"
    if not identity.is_file():
        return identity, "missing"
    mode = stat.S_IMODE(identity.stat().st_mode)
    if mode & 0o077:
        return identity, f"unsafe permissions {mode:04o}; expected 0600"
    return identity, None


def _encrypted_identity_status(home: pathlib.Path) -> tuple[pathlib.Path, str | None]:
    """Return the encrypted identity path and an error when it is unavailable."""

    identity = home / AGE_ENCRYPTED_IDENTITY
    if identity.is_symlink():
        return identity, "must be a regular file, not a symlink"
    if not identity.is_file():
        return identity, "missing"
    return identity, None


def _run_age_to_file(
    age: pathlib.Path,
    args: list[str],
    output: pathlib.Path,
    *,
    action: str,
) -> None:
    """Run an interactive age operation with atomic output."""

    output.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd, tmp_name = tempfile.mkstemp(prefix=f".{output.name}.", dir=output.parent)
    os.close(fd)
    pathlib.Path(tmp_name).unlink()
    try:
        result = subprocess.run([str(age), *args[:-1], "--output", tmp_name, args[-1]])
        if result.returncode != 0:
            raise RuntimeError(f"Failed to {action}")
        pathlib.Path(tmp_name).chmod(0o600)
        pathlib.Path(tmp_name).replace(output)
    except BaseException:
        pathlib.Path(tmp_name).unlink(missing_ok=True)
        raise


@contextlib.contextmanager
def _secret_identity(
    age: pathlib.Path,
    home: pathlib.Path,
) -> Iterator[pathlib.Path]:
    """Unlock the managed identity or fall back to a legacy local one."""

    encrypted, encrypted_error = _encrypted_identity_status(home)
    if encrypted_error is None:
        with tempfile.TemporaryDirectory(prefix="dotfiles-age-") as tmp:
            unlocked = pathlib.Path(tmp) / "identity.txt"
            _run_age_to_file(
                age,
                ["--decrypt", str(encrypted)],
                unlocked,
                action=f"unlock encrypted identity {encrypted}",
            )
            yield unlocked
        return
    if encrypted_error != "missing":
        raise RuntimeError(f"{encrypted}: {encrypted_error}")

    identity, identity_error = _identity_status(home)
    if identity_error:
        raise RuntimeError(
            f"{encrypted}: missing; {identity}: {identity_error}. "
            "Run 'dotfiles secrets init' on the source machine, commit and push "
            "the generated files, then update this machine."
        )
    yield identity


def _stage_identity_files(
    dotfiles_dir: pathlib.Path,
    home: pathlib.Path,
    paths: tuple[pathlib.Path, ...],
) -> None:
    """Stage generated identity metadata in the bare repository."""

    relative = [str(path.relative_to(home)) for path in paths]
    subprocess.run(
        [
            "git",
            "--git-dir",
            str(dotfiles_dir),
            "--work-tree",
            str(home),
            "add",
            "--sparse",
            "--",
            *relative,
        ],
        cwd=home,
        check=True,
        capture_output=True,
    )


def _secret_source_for_target(
    target: pathlib.Path,
    home: pathlib.Path,
    dotfiles_dir: pathlib.Path,
    backup_dir: pathlib.Path,
) -> tuple[pathlib.Path, pathlib.PurePosixPath]:
    """Map one regular file below HOME to its encrypted repository path."""

    home_absolute = pathlib.Path(os.path.abspath(home))  # noqa: PTH100
    # Preserve symlink boundaries here, unlike resolve().
    target_absolute = pathlib.Path(os.path.abspath(target.expanduser()))  # noqa: PTH100
    if not target_absolute.is_relative_to(home_absolute):
        raise RuntimeError(f"Secret source is outside HOME: {target}")
    for path in (target_absolute, *target_absolute.parents):
        if path == home_absolute:
            break
        if path.is_symlink():
            raise RuntimeError(f"Secret source crosses a symlink: {target}")
    if not target_absolute.is_file():
        raise RuntimeError(f"Secret source is not a regular file: {target}")

    relative = target_absolute.relative_to(home_absolute)
    tracked = subprocess.run(
        [
            "git",
            "--git-dir",
            str(dotfiles_dir),
            "ls-files",
            "--error-unmatch",
            "--",
            relative.as_posix(),
        ],
        capture_output=True,
    )
    excluded = relative.parts[0] in (
        *SPARSE_TRACKED_EXCLUDES,
        *SPARSE_UNTRACKED_GUARDS,
    )
    if tracked.returncode == 0 and not excluded:
        raise RuntimeError(f"Secret source is already a public dotfile: {target}")

    source = SECRETS_PREFIX / pathlib.PurePosixPath(f"{relative.as_posix()}.age")
    _secret_target(source, home, dotfiles_dir, backup_dir)
    return target_absolute, source


def _unmerged_paths(
    dotfiles_dir: pathlib.Path,
    *,
    env: dict[str, str] | None = None,
) -> list[str]:
    """Return unresolved paths from the shared Git index."""

    result = subprocess.run(
        ["git", "--git-dir", str(dotfiles_dir), "ls-files", "--unmerged", "-z"],
        env=env,
        check=True,
        capture_output=True,
    )
    return sorted(
        {
            entry.split(b"\t", maxsplit=1)[1].decode("utf-8")
            for entry in result.stdout.split(b"\0")
            if entry
        }
    )


def _staged_paths(dotfiles_dir: pathlib.Path) -> list[str]:
    """Return paths that differ between HEAD and the shared Git index."""

    result = subprocess.run(
        [
            "git",
            "--git-dir",
            str(dotfiles_dir),
            "diff",
            "--cached",
            "--name-only",
            "-z",
        ],
        check=True,
        capture_output=True,
    )
    return sorted(path.decode("utf-8") for path in result.stdout.split(b"\0") if path)


def _ensure_secret_source_can_be_staged(
    dotfiles_dir: pathlib.Path,
    source: pathlib.PurePosixPath,
    *,
    resolve: bool,
    env: dict[str, str] | None = None,
) -> bool:
    """Reject unresolved merges and an existing staged edit to the ciphertext."""

    unmerged = _unmerged_paths(dotfiles_dir, env=env)
    if unmerged:
        source_path = str(source)
        others = [path for path in unmerged if path != source_path]
        if resolve and not others and source_path in unmerged:
            return True
        if source_path in unmerged and others:
            paths = "\n".join(f"  {path}" for path in others)
            raise RuntimeError(
                f"Other unresolved paths prevent resolving {source}:\n{paths}\n"
                "Resolve and stage them first, then re-run this command with "
                "'--resolve'."
            )
        if source_path in unmerged:
            raise RuntimeError(
                f"Encrypted source has an unresolved merge conflict: {source}. "
                "Re-run the same command with '--resolve' to replace it from "
                "the plaintext HOME file."
            )
        paths = "\n".join(f"  {path}" for path in unmerged)
        raise RuntimeError(
            f"Repository index has unresolved merge conflicts:\n{paths}\n"
            "Resolve them before encrypting another secret."
        )

    staged = subprocess.run(
        [
            "git",
            "--git-dir",
            str(dotfiles_dir),
            "diff",
            "--cached",
            "--quiet",
            "--",
            str(source),
        ],
        env=env,
        capture_output=True,
    )
    if staged.returncode == 1:
        raise RuntimeError(
            f"Encrypted source already has staged changes: {source}. "
            "Commit or unstage them before encrypting it again."
        )
    if staged.returncode != 0:
        raise RuntimeError(
            f"Failed to inspect staged state for {source}: "
            f"{staged.stderr.decode(errors='replace').strip()}"
        )
    return False


def _require_committed_recipients(
    dotfiles_dir: pathlib.Path,
    home: pathlib.Path,
) -> bytes:
    """Require the work-tree recipient to match the committed Git version."""

    recipients = home / AGE_RECIPIENTS
    if recipients.is_symlink() or not recipients.is_file():
        raise RuntimeError(
            f"Age recipients file is unavailable: {recipients}. "
            "Run 'dotfiles secrets init', commit, and push it first."
        )

    relative = str(AGE_RECIPIENTS)
    committed = subprocess.run(
        ["git", "--git-dir", str(dotfiles_dir), "show", f"HEAD:{relative}"],
        capture_output=True,
    )
    if committed.returncode != 0:
        raise RuntimeError(
            f"Age recipients file is not committed: {recipients}. "
            "Commit the staged identity metadata before encrypting secrets."
        )
    indexed = subprocess.run(
        ["git", "--git-dir", str(dotfiles_dir), "show", f":{relative}"],
        capture_output=True,
    )
    if indexed.returncode != 0 or indexed.stdout != committed.stdout:
        raise RuntimeError(
            f"Age recipients file has staged changes: {recipients}. "
            "Commit them before encrypting secrets."
        )
    if recipients.read_bytes() != indexed.stdout:
        raise RuntimeError(
            f"Age recipients file has unstaged changes: {recipients}. "
            "Restore it or stage and commit it before encrypting secrets."
        )
    return committed.stdout


def _remove_resolved_ciphertext(
    home: pathlib.Path,
    source: pathlib.PurePosixPath,
) -> None:
    """Remove a resolved sparse ciphertext file and its empty parents."""

    path = home.joinpath(*source.parts)
    if path.is_dir():
        raise RuntimeError(
            f"Conflicted ciphertext path is a directory and was not removed: {path}"
        )
    path.unlink(missing_ok=True)

    secrets_root = home / SECRETS_PREFIX.parts[0]
    parent = path.parent
    while parent != secrets_root.parent:
        if not parent.is_dir() or any(parent.iterdir()):
            break
        parent.rmdir()
        if parent == secrets_root:
            break
        parent = parent.parent


def _stage_sparse_blob(
    dotfiles_dir: pathlib.Path,
    home: pathlib.Path,
    source: pathlib.PurePosixPath,
    content: bytes,
    *,
    resolve: bool,
) -> None:
    """Atomically stage one sparse-excluded blob without writing into HOME."""

    blob = _write_git_blob(dotfiles_dir, content)
    index = dotfiles_dir / "index"
    lock = dotfiles_dir / "index.lock"
    fd = _create_index_lock(lock)

    # Leave the shared index untouched until the staged replacement is complete.
    try:
        _copy_index_to_lock(index, fd)
        _stage_sparse_blob_in_locked_index(
            dotfiles_dir,
            home,
            source,
            blob,
            lock,
            resolve=resolve,
        )
        lock.replace(index)
    except BaseException:
        # A stale index.lock would block later git operations after the real error.
        _cleanup_index_lock(lock)
        raise


def _write_git_blob(dotfiles_dir: pathlib.Path, content: bytes) -> str:
    """Write content as a git blob and return its object id."""

    return (
        subprocess.run(
            ["git", "--git-dir", str(dotfiles_dir), "hash-object", "-w", "--stdin"],
            input=content,
            check=True,
            capture_output=True,
            text=False,
        )
        .stdout.decode("ascii")
        .strip()
    )


def _create_index_lock(lock: pathlib.Path) -> int:
    """Create lock exclusively and return its file descriptor."""

    try:
        return os.open(lock, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    except FileExistsError as exc:
        raise RuntimeError(
            f"Git index is locked: {lock}. Wait for the other Git operation to finish."
        ) from exc


def _copy_index_to_lock(index: pathlib.Path, fd: int) -> None:
    """Seed the locked index file with the current git index content."""

    with os.fdopen(fd, "wb") as stream:
        stream.write(index.read_bytes())


def _stage_sparse_blob_in_locked_index(
    dotfiles_dir: pathlib.Path,
    home: pathlib.Path,
    source: pathlib.PurePosixPath,
    blob: str,
    lock: pathlib.Path,
    *,
    resolve: bool,
) -> None:
    """Stage blob into the locked index and keep the path sparse."""

    env = {**os.environ, "GIT_INDEX_FILE": str(lock)}
    resolving = _ensure_secret_source_can_be_staged(
        dotfiles_dir,
        source,
        resolve=resolve,
        env=env,
    )
    if resolving:
        _remove_resolved_ciphertext(home, source)

    _update_locked_index(dotfiles_dir, home, source, blob, env)
    _mark_locked_index_skip_worktree(dotfiles_dir, home, source, env)


def _update_locked_index(
    dotfiles_dir: pathlib.Path,
    home: pathlib.Path,
    source: pathlib.PurePosixPath,
    blob: str,
    env: Mapping[str, str],
) -> None:
    """Add blob at source to the temporary git index."""

    subprocess.run(
        [
            "git",
            "--git-dir",
            str(dotfiles_dir),
            "update-index",
            "--add",
            "--cacheinfo",
            "100644",
            blob,
            str(source),
        ],
        env=env,
        cwd=home,
        check=True,
        capture_output=True,
    )


def _mark_locked_index_skip_worktree(
    dotfiles_dir: pathlib.Path,
    home: pathlib.Path,
    source: pathlib.PurePosixPath,
    env: Mapping[str, str],
) -> None:
    """Mark source skip-worktree in the temporary git index."""

    subprocess.run(
        [
            "git",
            "--git-dir",
            str(dotfiles_dir),
            "--work-tree",
            str(home),
            "update-index",
            "--skip-worktree",
            "--",
            str(source),
        ],
        env=env,
        cwd=home,
        check=True,
        capture_output=True,
    )


def _cleanup_index_lock(lock: pathlib.Path) -> None:
    """Remove the temporary git index and any nested git lockfile."""

    lock.unlink(missing_ok=True)
    pathlib.Path(f"{lock}.lock").unlink(missing_ok=True)


def encrypt_secret(
    dotfiles_dir: pathlib.Path,
    home: pathlib.Path,
    backup_dir: pathlib.Path,
    target: pathlib.Path,
    *,
    resolve: bool = False,
) -> None:
    """Encrypt and stage one HOME file through its deterministic mapping."""

    if not dotfiles_dir.is_dir():
        raise RuntimeError(
            f"dotfiles repository not found: {dotfiles_dir}. Bootstrap first."
        )
    backup_dir = _manifest_backup_dir(_read_manifest(dotfiles_dir), backup_dir)
    target, source = _secret_source_for_target(target, home, dotfiles_dir, backup_dir)
    _ensure_secret_source_can_be_staged(dotfiles_dir, source, resolve=resolve)

    age = find_age()
    if age is None:
        raise RuntimeError("age is not installed")
    recipients = _require_committed_recipients(dotfiles_dir, home)

    with tempfile.TemporaryDirectory(prefix="dotfiles-age-") as tmp:
        encrypted = pathlib.Path(tmp) / "secret.age"
        recipients_file = pathlib.Path(tmp) / "recipients.txt"
        recipients_file.write_bytes(recipients)
        result = subprocess.run(
            [
                str(age),
                "--encrypt",
                "--armor",
                "--recipients-file",
                str(recipients_file),
                "--output",
                str(encrypted),
                str(target),
            ],
            capture_output=True,
        )
        if result.returncode != 0:
            message = result.stderr.decode(errors="replace").strip()
            raise RuntimeError(f"Failed to encrypt {target}: {message}")
        ciphertext = encrypted.read_bytes()

    _stage_sparse_blob(
        dotfiles_dir,
        home,
        source,
        ciphertext,
        resolve=resolve,
    )
    console.print(f"==> Encrypted {target}", soft_wrap=True)
    console.print(f"==> Staged {source}", soft_wrap=True)


def init_secret_identity(
    dotfiles_dir: pathlib.Path,
    home: pathlib.Path,
) -> None:
    """Create and stage one passphrase-encrypted shared age identity."""

    age = find_age()
    if age is None:
        raise RuntimeError("age is not installed")
    age_keygen = find_age_keygen(age)
    if age_keygen is None:
        raise RuntimeError("age-keygen is not installed")

    encrypted, encrypted_error = _encrypted_identity_status(home)
    recipients = home / AGE_RECIPIENTS
    _require_missing_identity_metadata(
        encrypted,
        encrypted_error,
        recipients=recipients,
    )

    identity, identity_error = _identity_status(home)
    _require_usable_identity_source(
        dotfiles_dir,
        identity=identity,
        identity_error=identity_error,
    )

    with tempfile.TemporaryDirectory(prefix="dotfiles-age-") as tmp:
        source = _identity_source_for_init(
            pathlib.Path(tmp),
            age_keygen=age_keygen,
            identity=identity,
            identity_error=identity_error,
        )
        recipient = _identity_recipient_text(age_keygen, source)
        _encrypt_identity_for_init(
            age,
            encrypted=encrypted,
            identity=identity,
            source=source,
        )
        _write_identity_recipients(recipients, recipient)

    _stage_identity_files(dotfiles_dir, home, (encrypted, recipients))
    console.print(
        "==> Created and staged the encrypted age identity and public recipient.",
        soft_wrap=True,
    )
    if identity_error is None:
        console.print(
            f"[yellow]==> Existing plaintext identity preserved at {identity}. "
            "Remove it after committing and verifying the encrypted identity.[/yellow]",
            soft_wrap=True,
        )


def _require_missing_identity_metadata(
    encrypted: pathlib.Path,
    encrypted_error: str | None,
    *,
    recipients: pathlib.Path,
) -> None:
    """Reject an init when encrypted identity metadata already exists."""

    if encrypted_error is None or recipients.exists():
        raise RuntimeError(
            f"Encrypted identity metadata already exists: {encrypted} or {recipients}"
        )
    if encrypted_error != "missing":
        raise RuntimeError(f"{encrypted}: {encrypted_error}")


def _require_usable_identity_source(
    dotfiles_dir: pathlib.Path,
    *,
    identity: pathlib.Path,
    identity_error: str | None,
) -> None:
    """Reject an init when the plaintext identity state is unusable."""

    if identity_error not in (None, "missing"):
        raise RuntimeError(f"{identity}: {identity_error}")
    if identity_error == "missing" and _secret_sources(dotfiles_dir):
        raise RuntimeError(
            "Encrypted sources already exist but no usable identity is available"
        )


def _identity_source_for_init(
    tmp: pathlib.Path,
    *,
    age_keygen: pathlib.Path,
    identity: pathlib.Path,
    identity_error: str | None,
) -> pathlib.Path:
    """Return the identity file that init must encrypt."""

    if identity_error != "missing":
        return identity

    generated = tmp / "identity.txt"
    subprocess.run(
        [str(age_keygen), "--output", str(generated)],
        check=True,
    )
    return generated


def _identity_recipient_text(age_keygen: pathlib.Path, source: pathlib.Path) -> str:
    """Return the public recipient derived from source, newline-terminated."""

    recipient = subprocess.run(
        [str(age_keygen), "-y", str(source)],
        check=True,
        capture_output=True,
        text=True,
    ).stdout
    if recipient.endswith("\n"):
        return recipient
    return f"{recipient}\n"


def _encrypt_identity_for_init(
    age: pathlib.Path,
    *,
    encrypted: pathlib.Path,
    identity: pathlib.Path,
    source: pathlib.Path,
) -> None:
    """Write the encrypted shared identity to its tracked location."""

    _run_age_to_file(
        age,
        ["--encrypt", "--passphrase", "--armor", str(source)],
        encrypted,
        action=f"encrypt age identity {identity}",
    )


def _write_identity_recipients(recipients: pathlib.Path, recipient: str) -> None:
    """Write the tracked public recipient file with repo-stable permissions."""

    recipients.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    recipients.write_text(recipient, encoding="utf-8")
    recipients.chmod(0o644)


def change_secret_passphrase(
    dotfiles_dir: pathlib.Path,
    home: pathlib.Path,
) -> None:
    """Re-encrypt and stage the shared identity with a new passphrase."""

    age = find_age()
    if age is None:
        raise RuntimeError("age is not installed")
    encrypted, encrypted_error = _encrypted_identity_status(home)
    if encrypted_error:
        raise RuntimeError(f"{encrypted}: {encrypted_error}")

    with tempfile.TemporaryDirectory(prefix="dotfiles-age-") as tmp:
        unlocked = pathlib.Path(tmp) / "identity.txt"
        _run_age_to_file(
            age,
            ["--decrypt", str(encrypted)],
            unlocked,
            action=f"unlock encrypted identity {encrypted}",
        )
        _run_age_to_file(
            age,
            ["--encrypt", "--passphrase", "--armor", str(unlocked)],
            encrypted,
            action=f"change passphrase for {encrypted}",
        )

    _stage_identity_files(dotfiles_dir, home, (encrypted,))
    console.print(
        "==> Changed the passphrase and staged the encrypted identity.",
        soft_wrap=True,
    )


def _secret_entries(manifest: dict[str, object]) -> dict[str, dict[str, str]]:
    """Return validated secret manifest entries."""

    raw = manifest.get("secrets", {})
    if not isinstance(raw, dict):
        raise RuntimeError("Invalid secrets section in manifest")

    entries: dict[str, dict[str, str]] = {}
    for rel, entry in raw.items():
        if not isinstance(rel, str) or not isinstance(entry, dict):
            raise RuntimeError("Invalid secret entry in manifest")
        source_blob = entry.get("source_blob")
        plaintext_sha256 = entry.get("plaintext_sha256")
        if not isinstance(source_blob, str) or not isinstance(plaintext_sha256, str):
            raise RuntimeError(f"Invalid secret entry in manifest: {rel}")
        entries[rel] = {
            "source_blob": source_blob,
            "plaintext_sha256": plaintext_sha256,
        }
    return entries


def _manifest_paths(manifest: dict[str, object], key: str) -> list[pathlib.Path]:
    """Return the valid path entries stored under key in manifest."""

    value = manifest.get(key, [])
    if not isinstance(value, list):
        return []
    return [pathlib.Path(path) for path in value if isinstance(path, str)]


def _manifest_backup_dir(
    manifest: dict[str, object],
    fallback: pathlib.Path,
) -> pathlib.Path:
    """Use the backup directory recorded during bootstrap when available."""

    value = manifest.get("backup_dir")
    if value is None:
        return fallback
    if not isinstance(value, str):
        raise RuntimeError("Invalid backup_dir in manifest")
    return pathlib.Path(value)


def _notify_encrypted_sources(dotfiles_dir: pathlib.Path) -> None:
    """Report tracked ciphertext without applying it automatically."""

    count = len(_secret_sources(dotfiles_dir))
    if count:
        console.print(
            f"[yellow]==> {count} encrypted file(s) available. "
            "Run 'dotfiles secrets status' or 'dotfiles secrets apply'.[/yellow]",
            soft_wrap=True,
        )


def secret_status(
    dotfiles_dir: pathlib.Path,
    home: pathlib.Path,
    backup_dir: pathlib.Path,
) -> int:
    """Report encrypted-source and deployed-target state without decrypting."""

    manifest = _read_manifest(dotfiles_dir)
    backup_dir = _manifest_backup_dir(manifest, backup_dir)
    specs = discover_secrets(dotfiles_dir, home, backup_dir)
    deployed = _secret_entries(manifest)
    age = find_age()
    identity, identity_error = _identity_status(home)
    encrypted_identity, encrypted_identity_error = _encrypted_identity_status(home)

    console.print(f"==> age: {age or '[yellow]not found[/yellow]'}", soft_wrap=True)
    if encrypted_identity_error is None:
        console.print(
            f"==> identity: {encrypted_identity} "
            "[yellow](encrypted; passphrase required)[/yellow]",
            soft_wrap=True,
        )
    elif encrypted_identity_error == "missing" and identity_error is None:
        console.print(
            f"==> identity: {identity} [yellow](legacy plaintext)[/yellow]",
            soft_wrap=True,
        )
    else:
        detail = encrypted_identity_error
        path = encrypted_identity
        if encrypted_identity_error == "missing":
            detail = identity_error
            path = identity
        console.print(
            f"==> identity: {path} [yellow]({detail})[/yellow]",
            soft_wrap=True,
        )
    console.print(f"==> encrypted files: {len(specs)}")

    for spec in specs:
        rel = str(spec.target.relative_to(home))
        entry = deployed.get(rel)
        if spec.target.is_symlink() or (
            spec.target.exists() and not spec.target.is_file()
        ):
            state = "modified"
        elif not spec.target.is_file():
            state = "missing"
        elif entry is None:
            state = "unmanaged"
        elif entry.get("plaintext_sha256") != _sha256(spec.target.read_bytes()):
            state = "modified"
        elif entry.get("source_blob") != spec.source_blob:
            state = "stale"
        else:
            state = "current"
        console.print(f"    {state:9} {spec.target}", soft_wrap=True)

    current = {str(spec.target.relative_to(home)) for spec in specs}
    for rel in sorted(deployed.keys() - current):
        console.print(f"    {'orphaned':9} {home / rel}", soft_wrap=True)
    return 0


def _decrypt_secret(
    age: pathlib.Path,
    identity: pathlib.Path,
    ciphertext: bytes,
    source: pathlib.PurePosixPath,
) -> bytes:
    """Decrypt one blob without exposing plaintext in logs."""

    result = subprocess.run(
        [str(age), "--decrypt", "--identity", str(identity)],
        input=ciphertext,
        capture_output=True,
    )
    if result.returncode != 0:
        message = result.stderr.decode(errors="replace").strip()
        raise RuntimeError(f"Failed to decrypt {source}: {message}")
    return result.stdout


def _write_secret_target(target: pathlib.Path, content: bytes) -> None:
    """Atomically replace one decrypted target."""

    target.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd, tmp_name = tempfile.mkstemp(prefix=f".{target.name}.", dir=target.parent)
    try:
        with os.fdopen(fd, "wb") as stream:
            stream.write(content)
        pathlib.Path(tmp_name).chmod(0o600)
        pathlib.Path(tmp_name).replace(target)
    except BaseException:
        pathlib.Path(tmp_name).unlink(missing_ok=True)
        raise


def _remove_orphaned_secret(
    rel: str,
    entries: dict[str, dict[str, str]],
    manifest: dict[str, object],
    dotfiles_dir: pathlib.Path,
    home: pathlib.Path,
    backup_dir: pathlib.Path,
    *,
    force: bool,
) -> None:
    """Remove one source-less plaintext and restore its pristine backup."""

    target = home / rel
    backup = backup_dir / rel
    entry = entries[rel]
    target_is_managed = (
        target.is_file()
        and not target.is_symlink()
        and _sha256(target.read_bytes()) == entry["plaintext_sha256"]
    )
    target_is_restored = _same_content(target, backup)

    if target.exists() and not (target_is_managed or target_is_restored or force):
        raise RuntimeError(f"Refusing to remove locally modified orphan: {target}")
    if target_is_managed or force:
        target.unlink(missing_ok=True)
    if backup.exists() and not target_is_restored:
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(backup, target)

    entries.pop(rel)
    manifest["secrets"] = entries
    _write_manifest_data(dotfiles_dir, manifest)
    backup.unlink(missing_ok=True)


def _deploy_secret(
    spec: SecretSpec,
    content: bytes,
    entries: dict[str, dict[str, str]],
    manifest: dict[str, object],
    dotfiles_dir: pathlib.Path,
    home: pathlib.Path,
    backup_dir: pathlib.Path,
) -> None:
    """Deploy one validated plaintext and persist its manifest entry."""

    relative_target = spec.target.relative_to(home)
    relative_target_text = str(relative_target)
    current = spec.target.read_bytes() if spec.target.is_file() else None
    entry = {
        "source_blob": spec.source_blob,
        "plaintext_sha256": _sha256(content),
    }
    is_new = relative_target_text not in entries
    if is_new and current is not None:
        backup = backup_dir / relative_target
        if not backup.exists():
            backup.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
            shutil.copy2(spec.target, backup)
    if is_new:
        entries[relative_target_text] = entry
        manifest["secrets"] = entries
        _write_manifest_data(dotfiles_dir, manifest)

    if current != content:
        _write_secret_target(spec.target, content)

    if not is_new:
        entries[relative_target_text] = entry
        manifest["secrets"] = entries
        _write_manifest_data(dotfiles_dir, manifest)


def apply_secrets(
    dotfiles_dir: pathlib.Path,
    home: pathlib.Path,
    backup_dir: pathlib.Path,
    *,
    force: bool = False,
) -> None:
    """Reconcile encrypted sources and deployed plaintext files."""

    manifest = _read_manifest(dotfiles_dir)
    backup_dir = _manifest_backup_dir(manifest, backup_dir)
    specs = discover_secrets(dotfiles_dir, home, backup_dir)
    entries = _secret_entries(manifest)

    age = find_age()
    identity, identity_error = _identity_status(home)
    encrypted_identity, encrypted_identity_error = _encrypted_identity_status(home)
    identity_available = encrypted_identity_error is None or (
        encrypted_identity_error == "missing" and identity_error is None
    )
    _require_secret_runtime(
        specs,
        age,
        identity_available=identity_available,
        identity=identity,
        identity_error=identity_error,
        encrypted_identity=encrypted_identity,
        encrypted_identity_error=encrypted_identity_error,
    )

    # Decrypt before mutating HOME so a prompt or decrypt failure leaves no partial apply.
    candidates = _decrypted_secret_candidates(specs, age, dotfiles_dir, home)
    checked_out = _validated_checked_out(manifest)
    # Check both tracked targets and manifest orphans before replacing any plaintext.
    modified = _modified_secret_targets(
        candidates,
        checked_out,
        entries,
        home=home,
        backup_dir=backup_dir,
    )
    current_targets = _current_secret_targets(specs, home)
    modified.extend(
        _modified_orphaned_secret_targets(
            entries,
            current_targets,
            home=home,
            backup_dir=backup_dir,
        )
    )

    if modified and not force:
        paths = "\n".join(f"  {path}" for path in modified)
        raise RuntimeError(
            "Refusing to overwrite locally modified secret file(s):\n"
            f"{paths}\nRe-run with --force to replace them."
        )

    for relative_target in sorted(entries.keys() - current_targets):
        _remove_orphaned_secret(
            relative_target,
            entries,
            manifest,
            dotfiles_dir,
            home,
            backup_dir,
            force=force,
        )
    for spec, content in candidates.items():
        _deploy_secret(
            spec,
            content,
            entries,
            manifest,
            dotfiles_dir,
            home,
            backup_dir,
        )

    console.print(f"[green]==> Reconciled {len(candidates)} encrypted file(s).[/green]")


def _require_secret_runtime(
    specs: list[SecretSpec],
    age: pathlib.Path | None,
    *,
    identity_available: bool,
    identity: pathlib.Path,
    identity_error: str | None,
    encrypted_identity: pathlib.Path,
    encrypted_identity_error: str | None,
) -> None:
    """Reject apply when encrypted sources exist but decryption cannot run."""

    if not specs or (age is not None and identity_available):
        return

    reasons: list[str] = []
    if age is None:
        reasons.append("age is not installed")
    if encrypted_identity_error != "missing":
        reasons.append(f"{encrypted_identity}: {encrypted_identity_error}")
    elif identity_error:
        reasons.append(f"{encrypted_identity}: missing; {identity}: {identity_error}")
    paths = "\n".join(f"  {spec.target}" for spec in specs)
    raise RuntimeError(
        f"{len(specs)} encrypted file(s) pending: {'; '.join(reasons)}\n"
        f"{paths}\nRun 'dotfiles secrets init' on the source machine, commit "
        "and push the generated identity metadata, then run "
        "'dotfiles secrets apply'."
    )


def _decrypted_secret_candidates(
    specs: list[SecretSpec],
    age: pathlib.Path | None,
    dotfiles_dir: pathlib.Path,
    home: pathlib.Path,
) -> dict[SecretSpec, bytes]:
    """Decrypt every tracked secret source before any target is modified."""

    if not specs:
        return {}

    assert age is not None
    candidates: dict[SecretSpec, bytes] = {}
    with _secret_identity(age, home) as usable_identity:
        for spec in specs:
            ciphertext = _git_bytes(dotfiles_dir, "cat-file", "blob", spec.source_blob)
            candidates[spec] = _decrypt_secret(
                age, usable_identity, ciphertext, spec.source
            )
    return candidates


def _validated_checked_out(manifest: dict[str, object]) -> list[str]:
    """Return the manifest checked_out list, or raise on invalid content."""

    checked_out = manifest.get("checked_out", [])
    if not isinstance(checked_out, list) or not all(
        isinstance(path, str) for path in checked_out
    ):
        raise RuntimeError("Invalid checked_out section in manifest")
    return checked_out


def _modified_secret_targets(
    candidates: dict[SecretSpec, bytes],
    checked_out: list[str],
    entries: dict[str, dict[str, str]],
    *,
    home: pathlib.Path,
    backup_dir: pathlib.Path,
) -> list[pathlib.Path]:
    """Return deployed secret targets that apply would overwrite."""

    modified: list[pathlib.Path] = []
    for spec, content in candidates.items():
        rel = str(spec.target.relative_to(home))
        if rel in checked_out:
            raise RuntimeError(
                f"Encrypted target collides with a public dotfile: {spec.target}"
            )
        if spec.target.is_symlink():
            raise RuntimeError(f"Secret target is a symlink: {spec.target}")
        if not spec.target.exists():
            continue
        if not spec.target.is_file():
            raise RuntimeError(f"Secret target is not a regular file: {spec.target}")
        if _secret_target_is_modified(
            spec,
            content,
            entries.get(rel),
            backup_dir=backup_dir,
            home=home,
        ):
            modified.append(spec.target)
    return modified


def _secret_target_is_modified(
    spec: SecretSpec,
    content: bytes,
    entry: dict[str, str] | None,
    *,
    backup_dir: pathlib.Path,
    home: pathlib.Path,
) -> bool:
    """Return whether one existing deployed target counts as a local edit."""

    current = spec.target.read_bytes()
    if current == content:
        return False
    backup = backup_dir / spec.target.relative_to(home)
    interrupted_first_apply = (
        entry is not None
        and backup.is_file()
        and current == backup.read_bytes()
        and entry["plaintext_sha256"] == _sha256(content)
    )
    return (
        entry is not None
        and entry["plaintext_sha256"] != _sha256(current)
        and not interrupted_first_apply
    )


def _current_secret_targets(
    specs: list[SecretSpec],
    home: pathlib.Path,
) -> set[str]:
    """Return the manifest keys that still have a tracked ciphertext source."""

    return {str(spec.target.relative_to(home)) for spec in specs}


def _modified_orphaned_secret_targets(
    entries: dict[str, dict[str, str]],
    current_targets: set[str],
    *,
    home: pathlib.Path,
    backup_dir: pathlib.Path,
) -> list[pathlib.Path]:
    """Return source-less secret targets that apply would treat as modified."""

    modified: list[pathlib.Path] = []
    for relative_target in entries.keys() - current_targets:
        target = home / relative_target
        backup = backup_dir / relative_target
        if target.is_dir():
            raise RuntimeError(f"Orphaned secret target is a directory: {target}")
        if target.is_symlink():
            modified.append(target)
            continue
        if not target.exists():
            continue
        target_is_managed = (
            target.is_file()
            and not target.is_symlink()
            and _sha256(target.read_bytes())
            == entries[relative_target]["plaintext_sha256"]
        )
        target_is_restored = _same_content(target, backup)
        if not (target_is_managed or target_is_restored):
            modified.append(target)
    return modified


class RollbackStack:
    """Tracks reversible mutations; executes them in reverse on rollback."""

    def __init__(self) -> None:
        self._stack: list[tuple[str, Callable[[], None]]] = []

    def push(
        self,
        description: str,
        fn: Callable[[], None],
    ) -> None:
        """Register a reversible action with a human-readable description."""

        self._stack.append((description, fn))

    def rollback(self) -> None:
        """Execute all registered actions in reverse order, ignoring individual errors."""

        err_console.print(
            "\n[bold red]An error occurred, rolling back changes...[/bold red]"
        )

        for description, fn in reversed(self._stack):
            err_console.print(f"  ↩ {description}")
            try:
                fn()
            except Exception as exc:
                err_console.print(f"    [red]✗ failed: {describe_error(exc)}[/red]")


# ============
# DotfilesRepo
# ============


@dataclasses.dataclass
class DotfilesRepo:
    """Bare git repo living in ~/.dotfiles with HOME as its work-tree.

    Clones the dotfiles repo, configures sparse checkout, and checks out
    tracked files directly into HOME, backing up any pre-existing conflicts.
    """

    repo_uri: dataclasses.InitVar[str]
    overwrite_git_dir: dataclasses.InitVar[bool] = False
    branch: dataclasses.InitVar[str | None] = None
    origin_uri: dataclasses.InitVar[str | None] = None

    home: pathlib.Path = dataclasses.field(default_factory=pathlib.Path.home)

    dotfiles_dir: pathlib.Path = dataclasses.field(
        default_factory=lambda: pathlib.Path.home() / ".dotfiles"
    )

    backup_dir: pathlib.Path = dataclasses.field(
        default_factory=lambda: pathlib.Path.home() / ".dotfiles_backup"
    )

    repo: git.Repo = dataclasses.field(init=False)

    previous_manifest: dict[str, object] = dataclasses.field(
        init=False, default_factory=dict
    )

    previous_digests: dict[pathlib.Path, str] = dataclasses.field(
        init=False, default_factory=dict
    )

    def __post_init__(
        self,
        repo_uri: str,
        overwrite_git_dir: bool = False,
        branch: str | None = None,
        origin_uri: str | None = None,
    ) -> None:
        """Resolve the repo source, optionally remove an existing dotfiles dir, then clone.

        With origin_uri, the origin remote of the clone points there instead of
        at the source, so that --update and git push use the upstream repo.
        """

        repo_source = self._normalized_repo_source(repo_uri)
        self._prepare_dotfiles_dir_for_clone(overwrite_git_dir=overwrite_git_dir)

        self.repo = self.clone(
            repo_source=repo_source,
            destination=self.dotfiles_dir,
            branch=branch,
        )
        self._rewrite_origin(origin_uri=origin_uri)
        self._restore_salvaged_manifest()

    @staticmethod
    def _normalized_repo_source(repo_uri: str) -> str:
        """Return the clone source for repo_uri.

        Local repositories are resolved to an absolute path so later error
        messages and the origin-rewrite flow use one canonical location.
        """

        parsed = urllib.parse.urlparse(repo_uri)
        if parsed.scheme in ("http", "https", "git"):
            return repo_uri

        if parsed.scheme not in ("file", ""):
            raise ValueError(f"Invalid repo URI: {repo_uri}")

        local_path = pathlib.Path(
            parsed.path if parsed.scheme == "file" else repo_uri
        ).resolve()
        # Accept linked worktrees and submodules too, where .git is a file.
        if not ((local_path / ".git").exists() or (local_path / "HEAD").is_file()):
            raise ValueError(f"Not a git repository: {local_path}")
        return str(local_path)

    def _prepare_dotfiles_dir_for_clone(self, *, overwrite_git_dir: bool) -> None:
        """Prepare self.dotfiles_dir for cloning.

        The clone must see either a missing destination or a previously
        salvaged bare repository, so the overwrite checks and removal stay
        grouped before git clone runs.
        """

        if not self.dotfiles_dir.exists():
            return

        if not overwrite_git_dir:
            raise RuntimeError(
                f"Dotfiles directory '{self.dotfiles_dir}' already exists"
            )

        if self.dotfiles_dir.is_dir():
            self._salvage_existing_dotfiles_dir()
            shutil.rmtree(self.dotfiles_dir)
            return

        self.dotfiles_dir.unlink()

    def _salvage_existing_dotfiles_dir(self) -> None:
        """Preserve state from the bare repo being replaced.

        The salvaged manifest and digests let a re-bootstrap recognise files it
        already deployed, so the next checkout does not back them up as if they
        were user originals.
        """

        # A misconfigured DOTFILES_DIR could point at real user data.
        # A bare git repo always has HEAD and objects/.
        if not self._looks_like_bare_repo(self.dotfiles_dir):
            raise RuntimeError(
                f"Refusing to overwrite '{self.dotfiles_dir}': it does not "
                "look like a dotfiles bare repo (missing HEAD/objects). "
                "Set DOTFILES_DIR correctly or remove it manually."
            )

        # Re-bootstrap needs the old manifest and digests before the bare repo disappears.
        self.previous_manifest = self._salvage_manifest(self.dotfiles_dir)
        self.previous_digests = _deployed_digests(
            self.dotfiles_dir,
            _git_head_sha(self.dotfiles_dir),
            _manifest_paths(self.previous_manifest, "checked_out"),
        )

    def _rewrite_origin(self, *, origin_uri: str | None) -> None:
        """Rewrite the clone's origin remote when requested.

        This happens after cloning because bootstrap may read from one
        repository but must later fetch and push against a different upstream.
        """

        if not origin_uri:
            return

        subprocess.run(
            [
                "git",
                "--git-dir",
                str(self.dotfiles_dir),
                "remote",
                "set-url",
                "origin",
                origin_uri,
            ],
            check=True,
            capture_output=True,
            text=True,
        )

    def _restore_salvaged_manifest(self) -> None:
        """Restore a salvaged manifest into the freshly cloned bare repo.

        The manifest write must wait until clone succeeds, otherwise a failed
        bootstrap could create state in a destination that git never finished
        creating.
        """

        # Without the manifest, a re-bootstrap would back up our own files as
        # the user's originals.
        if self.previous_manifest:
            _write_manifest_data(self.dotfiles_dir, self.previous_manifest)

    @staticmethod
    def _salvage_manifest(dotfiles_dir: pathlib.Path) -> dict[str, object]:
        """Return the manifest of dotfiles_dir, or an empty one if it is unreadable."""

        try:
            return _read_manifest(dotfiles_dir)
        except (OSError, ValueError, RuntimeError) as exc:
            err_console.print(
                f"[yellow]==> Ignoring the unreadable previous manifest: {exc}[/yellow]"
            )
            return {}

    @staticmethod
    def _looks_like_bare_repo(path: pathlib.Path) -> bool:
        """Return whether path has the on-disk signature of a bare git repo."""

        return (path / "HEAD").is_file() and (path / "objects").is_dir()

    @staticmethod
    def clone(
        repo_source: str,
        destination: pathlib.Path,
        branch: str | None = None,
    ) -> git.Repo:
        """Clone repo_source as a bare repository into destination and return it.

        With branch, HEAD points to that branch instead of the remote default.
        """

        console.print(f"==> Cloning dotfiles repo from [cyan]{repo_source}[/cyan]")
        branch_args = ["--branch", branch] if branch else []
        subprocess.run(
            [
                "git",
                "clone",
                "--quiet",
                "--bare",
                *branch_args,
                repo_source,
                str(destination),
            ],
            check=True,
            capture_output=True,
            text=True,
        )
        return git.Repo(str(destination))

    @staticmethod
    def configure_sparse_checkout(
        repo: git.Repo,
    ) -> None:
        """Write sparse-checkout rules and hide untracked files in the work-tree."""

        console.print("==> Configuring sparse checkout")
        cw = repo.config_writer()
        cw.set_value("status", "showUntrackedFiles", "no").release()
        cw.set_value("core", "sparseCheckout", "true").release()

        info_dir = pathlib.Path(repo.git_dir) / "info"
        info_dir.mkdir(parents=True, exist_ok=True)
        (info_dir / "sparse-checkout").write_text(SPARSE_CHECKOUT, encoding="utf-8")

    @staticmethod
    @contextlib.contextmanager
    def _sparse_worktree(
        git_dir: str,
        treeish: str,
    ) -> contextlib.AbstractContextManager[tuple[pathlib.Path, list[pathlib.Path]]]:
        """Check out the sparse set of treeish into a throwaway work-tree.

        Yields the temporary work-tree path and the relative files git actually
        wrote there. An isolated GIT_INDEX_FILE keeps the shared index untouched.
        The file list comes from what git wrote to disk, because the first
        read-tree does not populate skip-worktree bits even though excluded
        files are already withheld from the work-tree.
        """

        with tempfile.TemporaryDirectory(prefix="dotfiles-co-") as tmp:
            tmp_path = pathlib.Path(tmp)
            worktree = tmp_path / "worktree"
            worktree.mkdir()
            env = {**os.environ, "GIT_INDEX_FILE": str(tmp_path / "index")}
            subprocess.run(
                [
                    "git",
                    "--git-dir",
                    git_dir,
                    "--work-tree",
                    str(worktree),
                    "read-tree",
                    "--reset",
                    "-u",
                    treeish,
                ],
                check=True,
                capture_output=True,
                text=True,
                env=env,
            )
            files = sorted(
                p.relative_to(worktree)
                for p in worktree.rglob("*")
                if p.is_file() or p.is_symlink()
            )
            yield worktree, files

    @staticmethod
    def _copy_into_home(
        worktree: pathlib.Path,
        files: list[pathlib.Path],
        home: pathlib.Path,
    ) -> None:
        """Copy files from worktree into home, overwriting existing entries.

        Only the included files are written. Files already in HOME but not in
        that list, such as the user's own ~/.bashrc, are never removed. The
        checkout therefore copies from a throwaway work-tree instead of running
        read-tree -u directly against HOME, because a second read-tree -u would
        flip skip-worktree bits and delete excluded files.
        """

        for rel in files:
            src = worktree / rel
            dst = home / rel
            dst.parent.mkdir(parents=True, exist_ok=True)
            if dst.is_symlink() or (dst.exists() and not dst.is_dir()):
                dst.unlink()
            elif dst.is_dir():
                shutil.rmtree(dst)
            shutil.copy2(src, dst, follow_symlinks=False)

    @staticmethod
    def _populate_index(
        git_dir: str,
        home: pathlib.Path,
        checked_out: list[pathlib.Path],
    ) -> None:
        """Populate the shared index from HEAD so dotfiles git works.

        It uses read-tree --reset HEAD without -u so the work-tree is never
        touched, then marks sparse-excluded tracked files skip-worktree so
        dotfiles git status ignores them and dotfiles git commit -a never
        stages their spurious deletion.
        """

        subprocess.run(
            [
                "git",
                "--git-dir",
                git_dir,
                "--work-tree",
                str(home),
                "read-tree",
                "--reset",
                "HEAD",
            ],
            check=True,
            capture_output=True,
            text=True,
        )

        excluded = DotfilesRepo._excluded_tracked_paths(
            git_dir,
            checked_out=checked_out,
        )
        DotfilesRepo._hide_excluded_paths(git_dir, home, excluded)

    @staticmethod
    def _excluded_tracked_paths(
        git_dir: str,
        *,
        checked_out: list[pathlib.Path],
    ) -> list[str]:
        """Return tracked paths that sparse checkout kept out of HOME.

        The later index-flag pass must operate on exactly the tracked files git
        withheld, not on guessed path patterns, so it derives the list from
        git ls-files and the effective sparse result.
        """

        listed = subprocess.run(
            ["git", "--git-dir", git_dir, "ls-files"],
            check=True,
            capture_output=True,
            text=True,
        )
        included = {str(path) for path in checked_out}
        return [
            line for line in listed.stdout.splitlines() if line and line not in included
        ]

    @staticmethod
    def _hide_excluded_paths(
        git_dir: str,
        home: pathlib.Path,
        excluded: list[str],
    ) -> None:
        """Hide sparse-excluded tracked paths from dotfiles git status.

        Skip-worktree stays the first choice because it matches sparse
        checkout semantics, and the later assume-unchanged pass covers every
        excluded tracked path that still exists in HOME.
        """

        if not excluded:
            return

        # Try skip-worktree first for every excluded tracked path, then fall back
        # for the subset that still exists in HOME.
        DotfilesRepo._mark_skip_worktree(git_dir, home, excluded)
        collisions = DotfilesRepo._excluded_path_collisions(home, excluded=excluded)
        if collisions:
            DotfilesRepo._mark_assume_unchanged(git_dir, home, collisions)

    @staticmethod
    def _excluded_path_collisions(
        home: pathlib.Path,
        *,
        excluded: list[str],
    ) -> list[str]:
        """Return excluded tracked paths that already exist in HOME.

        Every excluded tracked path that still exists in HOME is marked
        assume-unchanged afterwards so dotfiles git status stays clean even
        when git refuses skip-worktree for a present, differing path.
        """

        # The user's own ~/.gitattributes or ~/.gitignore can sit at a
        # tracked repo-internal path because HOME is the work-tree. Git
        # refuses skip-worktree on a present path that differs from the
        # index, so assume-unchanged keeps dotfiles git status clean and
        # stops commit -a from staging the user's content forever.
        return [path for path in excluded if (home / path).exists()]

    @staticmethod
    def _mark_skip_worktree(
        git_dir: str,
        home: pathlib.Path,
        paths: list[str],
    ) -> None:
        """Mark paths skip-worktree in the shared index, best effort.

        The skip-worktree bits are a nicety on top of core.sparseCheckout.
        Recent git already hides sparse-excluded files from git status, and
        this marking only keeps that behaviour correct on older git.
        """

        DotfilesRepo._update_index_flag(
            git_dir, home, "--skip-worktree", paths, "skip-worktree"
        )

    @staticmethod
    def _mark_assume_unchanged(
        git_dir: str,
        home: pathlib.Path,
        paths: list[str],
    ) -> None:
        """Mark paths assume-unchanged in the shared index, best effort.

        Used as a fallback for sparse-excluded files the user already has in
        HOME. Modern git will not set skip-worktree on a present, differing
        path, so assume-unchanged is what actually keeps dotfiles git status
        clean for those collisions.
        """

        DotfilesRepo._update_index_flag(
            git_dir, home, "--assume-unchanged", paths, "assume-unchanged"
        )

    @staticmethod
    def _update_index_flag(
        git_dir: str,
        home: pathlib.Path,
        flag: str,
        paths: list[str],
        label: str,
    ) -> None:
        """Run update-index with one flag on the given paths, best effort.

        A failure here must never abort (and roll back) an otherwise successful
        checkout, so a single batch that returns non-zero is retried file by
        file and the few paths git refuses to mark are reported as a warning
        instead of raising.
        """

        base = ["git", "--git-dir", git_dir, "--work-tree", str(home)]
        batch = subprocess.run(
            [*base, "update-index", flag, "--", *paths],
            check=False,
            capture_output=True,
            text=True,
        )
        if batch.returncode == 0:
            return

        # The batch stops at the first path git cannot mark, so retry path by
        # path to skip only the offending entries.
        failed: list[str] = []
        for path in paths:
            single = subprocess.run(
                [*base, "update-index", flag, "--", path],
                check=False,
                capture_output=True,
                text=True,
            )
            if single.returncode != 0:
                failed.append(path)

        if failed:
            console.print(
                "==> [yellow]Warning:[/yellow] could not mark "
                f"{len(failed)} file(s) {label}: {', '.join(failed)}"
            )

    @staticmethod
    def checkout_to_home(
        repo: git.Repo,
        home: pathlib.Path,
        backup_dir: pathlib.Path,
        managed: frozenset[pathlib.Path] = frozenset(),
        forbidden: frozenset[pathlib.Path] = frozenset(),
    ) -> tuple[list[pathlib.Path], list[pathlib.Path]]:
        """Check out the sparse tracked files into home after backing up conflicts.

        Returns the backed-up paths and the paths actually written to HOME.
        Only files in the effective checkout set are considered for backup, so
        untracked user files such as the user's own ~/.bashrc are never
        touched. Managed files are refreshed in place because they are already
        ours, not the user's originals. Identical files are still backed up so
        rollback and uninstall can restore them, but notify_backups stays
        quiet. Existing backup entries are never overwritten, and the checkout
        copies from a throwaway sparse work-tree so excluded files are never
        deleted from HOME.
        """

        git_dir = str(repo.git_dir)

        with DotfilesRepo._sparse_worktree(git_dir, "HEAD") as (worktree, checked_out):
            DotfilesRepo._raise_for_forbidden_checkout(
                checked_out,
                forbidden=forbidden,
            )
            conflicts = DotfilesRepo._checkout_conflicts(
                checked_out,
                home=home,
                managed=managed,
            )
            # Plan every move before touching HOME so backups and parked files
            # are based on the same pre-checkout state.
            to_backup = DotfilesRepo._conflicts_needing_backup(
                conflicts,
                backup_dir=backup_dir,
            )
            to_park = DotfilesRepo._conflicts_needing_parking(
                conflicts,
                worktree=worktree,
                home=home,
                backup_dir=backup_dir,
                to_backup=to_backup,
            )
            DotfilesRepo._backup_checkout_conflicts(
                to_backup,
                worktree=worktree,
                home=home,
                backup_dir=backup_dir,
            )
            DotfilesRepo._park_checkout_conflicts(
                to_park,
                home=home,
                backup_dir=backup_dir,
            )
            console.print("==> Checking out dotfiles into home")
            DotfilesRepo._copy_into_home(worktree, checked_out, home)

        # Populate the shared index after the copy so git status reflects the new HOME tree.
        DotfilesRepo._populate_index(git_dir, home, checked_out)

        backed_up = [rel for rel in checked_out if (backup_dir / rel).exists()]

        return backed_up, checked_out

    @staticmethod
    def _raise_for_forbidden_checkout(
        checked_out: list[pathlib.Path],
        *,
        forbidden: frozenset[pathlib.Path],
    ) -> None:
        """Reject a checkout that would overwrite deployed secret targets.

        The checkout must fail before any backup or copy step when public files
        collide with secrets, otherwise the repo could overwrite a deployed
        secret with tracked plaintext.
        """

        overlap = sorted(set(checked_out) & forbidden)
        if not overlap:
            return

        paths = ", ".join(str(path) for path in overlap)
        raise RuntimeError(f"Public dotfiles overlap deployed secret targets: {paths}")

    @staticmethod
    def _checkout_conflicts(
        checked_out: list[pathlib.Path],
        *,
        home: pathlib.Path,
        managed: frozenset[pathlib.Path],
    ) -> list[pathlib.Path]:
        """Return pre-existing checkout targets that belong to the user, not us.

        This step only decides which existing HOME entries are user conflicts.
        The separate backup-selection step decides whether a preserved original
        already exists.
        """

        # Back up genuine user conflicts only: skip managed files.
        return [
            rel
            for rel in checked_out
            if rel not in managed
            and ((home / rel).exists() or (home / rel).is_symlink())
        ]

    @staticmethod
    def _conflicts_needing_backup(
        conflicts: list[pathlib.Path],
        *,
        backup_dir: pathlib.Path,
    ) -> list[pathlib.Path]:
        """Return conflicting paths whose first original still needs a backup.

        Existing backup entries are preserved so the first captured original
        remains available for later rollback and uninstall.
        """

        return [rel for rel in conflicts if not (backup_dir / rel).exists()]

    @staticmethod
    def _conflicts_needing_parking(
        conflicts: list[pathlib.Path],
        *,
        worktree: pathlib.Path,
        home: pathlib.Path,
        backup_dir: pathlib.Path,
        to_backup: list[pathlib.Path],
    ) -> list[pathlib.Path]:
        """Return later user variants that must be parked beside the backup.

        A later local variant cannot replace the original backup because
        rollback and uninstall must still restore the first user-owned file.
        """

        # The backup of these paths already holds the first original, so a
        # different user file found there now is kept next to it.
        return [
            rel
            for rel in conflicts
            if rel not in to_backup
            and not _same_content(home / rel, worktree / rel)
            and not _same_content(home / rel, backup_dir / rel)
        ]

    @staticmethod
    def _backup_checkout_conflicts(
        to_backup: list[pathlib.Path],
        *,
        worktree: pathlib.Path,
        home: pathlib.Path,
        backup_dir: pathlib.Path,
    ) -> None:
        """Move the first conflicting user files into the shared backup tree.

        Files identical to the incoming version are still backed up so rollback
        and uninstall restore the original mode and path state, but they are
        not announced because there is no content difference to review.
        """

        # Files identical to the incoming version are still backed up, so
        # rollback and uninstall restore them with their original mode, but
        # they are not worth announcing.
        differing = [
            rel for rel in to_backup if not _same_content(home / rel, worktree / rel)
        ]
        if differing:
            console.print(
                f"==> Backing up [yellow]{len(differing)}[/yellow] pre-existing file(s) to [cyan]{backup_dir}[/cyan]"
            )
        if not to_backup:
            return

        backup_dir.mkdir(parents=True, exist_ok=True)
        for rel in to_backup:
            dst = backup_dir / rel
            dst.parent.mkdir(parents=True, exist_ok=True)
            shutil.move(str(home / rel), str(dst))

    @staticmethod
    def _park_checkout_conflicts(
        to_park: list[pathlib.Path],
        *,
        home: pathlib.Path,
        backup_dir: pathlib.Path,
    ) -> None:
        """Move later local variants next to the preserved pristine backup.

        The parked copy keeps a later local variant recoverable without
        overwriting the first backup that rollback and uninstall still depend
        on.
        """

        for rel in to_park:
            dst = _unique_local_backup(backup_dir, rel)
            dst.parent.mkdir(parents=True, exist_ok=True)
            shutil.move(str(home / rel), str(dst))
            console.print(
                f"[yellow]==> {home / rel} already had a backup, saved it to "
                f"[cyan]{dst}[/cyan][/yellow]"
            )


# ========================
# Manifest + notifications
# ========================


def write_manifest(
    dotfiles_dir: pathlib.Path,
    backup_dir: pathlib.Path,
    backed_up: list[pathlib.Path],
    checked_out: list[pathlib.Path],
) -> None:
    """Persist a JSON manifest recording which files were checked out and backed up."""

    previous = _read_manifest(dotfiles_dir)
    manifest: dict[str, object] = {
        "timestamp": datetime.datetime.now(tz=datetime.timezone.utc).isoformat(),
        "backup_dir": str(backup_dir),
        "backed_up": [str(p) for p in backed_up],
        "checked_out": [str(p) for p in checked_out],
    }
    secrets = _secret_entries(previous)
    if secrets:
        manifest["secrets"] = secrets

    _write_manifest_data(dotfiles_dir, manifest)


def notify_backups(
    backed_up: list[pathlib.Path],
    home: pathlib.Path,
    backup_dir: pathlib.Path,
) -> None:
    """Print a rich-formatted notice listing each file that was backed up.

    A backup identical to the file now in HOME holds nothing to review, so it is
    left out of the notice.
    """

    backed_up = [
        rel for rel in backed_up if not _same_content(home / rel, backup_dir / rel)
    ]
    if not backed_up:
        return

    console.print()
    console.print(
        "[bold yellow]⚠  The following files were already present and have been backed up:[/bold yellow]"
    )

    for rel in backed_up:
        console.print(f"   [dim]{home / rel}[/dim]  →  [cyan]{backup_dir / rel}[/cyan]")

    console.print()
    console.print(
        "[yellow]Review them and merge any content you want to keep into the tracked versions.[/yellow]"
    )
    console.print()


def _run_git_passthrough(
    dotfiles_dir: pathlib.Path, home: pathlib.Path, git_args: list[str]
) -> int:
    """Run an arbitrary git command against the dotfiles bare repo, with output to the terminal."""
    result = subprocess.run(
        ["git", "--git-dir", str(dotfiles_dir), "--work-tree", str(home), *git_args],
    )
    return result.returncode


def _git_head_sha(dotfiles_dir: pathlib.Path) -> str:
    """Return the commit SHA that HEAD points to, or '' if it cannot be resolved."""

    result = subprocess.run(
        ["git", "--git-dir", str(dotfiles_dir), "rev-parse", "HEAD"],
        capture_output=True,
        text=True,
    )
    return result.stdout.strip() if result.returncode == 0 else ""


def _fetch_remote_tip(
    dotfiles_dir: pathlib.Path,
    branch: str,
) -> tuple[str, str]:
    """Fetch the remote and return the fetched target sha plus stderr text.

    git clone --bare leaves remote.origin.fetch empty, so a plain fetch would
    only move FETCH_HEAD. Update therefore fetches the current branch, or the
    remote default when HEAD is detached, and then reads the fetched tip from
    FETCH_HEAD. The caller moves the local branch ref to that tip. The target
    sha is an empty string when the fetch fails.
    """

    args = ["git", "--git-dir", str(dotfiles_dir), "fetch", "origin"]
    if branch:
        args.append(branch)
    fetched = subprocess.run(args, capture_output=True, text=True)
    if fetched.returncode != 0:
        return "", fetched.stderr

    tip = subprocess.run(
        ["git", "--git-dir", str(dotfiles_dir), "rev-parse", "FETCH_HEAD"],
        capture_output=True,
        text=True,
    )
    return (tip.stdout.strip() if tip.returncode == 0 else ""), fetched.stderr


def _warn_update_branch_mismatch(dotfiles_dir: pathlib.Path) -> None:
    """Warn if local HEAD tracks a branch other than the remote's default branch.

    --update re-checks out whatever local HEAD resolves to. If the bare repo
    was cloned from a non-default branch, local HEAD may not follow the branch
    that receives the remote's latest changes, so an update could silently
    re-apply an old tree. This is a best-effort guard: any failure (e.g. no
    network, no origin remote) is ignored.
    """

    try:
        local = subprocess.run(
            [
                "git",
                "--git-dir",
                str(dotfiles_dir),
                "rev-parse",
                "--abbrev-ref",
                "HEAD",
            ],
            capture_output=True,
            text=True,
        ).stdout.strip()

        ls_remote = subprocess.run(
            [
                "git",
                "--git-dir",
                str(dotfiles_dir),
                "ls-remote",
                "--symref",
                "origin",
                "HEAD",
            ],
            capture_output=True,
            text=True,
        )

        remote_default = ""
        for line in ls_remote.stdout.splitlines():
            if line.startswith("ref:"):
                remote_default = line.split()[1].rsplit("/", 1)[-1]
                break

        if remote_default and local and remote_default != local:
            err_console.print(
                f"[yellow]==> Warning: local HEAD tracks '{local}' but the remote "
                f"default branch is '{remote_default}'.[/yellow]"
            )
            err_console.print(
                "[yellow]    --update follows local HEAD; the remote's latest "
                "changes may live on a different branch.[/yellow]"
            )
    except Exception:  # noqa: S110  # Advisory branch check must never break --update.
        pass


def _current_branch(dotfiles_dir: pathlib.Path) -> str:
    """Return the short name of the branch HEAD points to, or '' if detached."""

    result = subprocess.run(
        ["git", "--git-dir", str(dotfiles_dir), "symbolic-ref", "--short", "HEAD"],
        capture_output=True,
        text=True,
    )
    return result.stdout.strip() if result.returncode == 0 else ""


def _local_modifications(
    dotfiles_dir: pathlib.Path,
    home: pathlib.Path,
    base_sha: str,
) -> list[pathlib.Path]:
    """Tracked dotfiles in HOME whose content differs from base_sha.

    These are the user's uncommitted edits that the re-checkout would overwrite.
    The comparison uses base_sha (HEAD before the fetch) so files that merely
    changed on the remote, but were not touched by the user, are not reported.
    Sparse-excluded files carry a skip-worktree bit, so they never show up
    as spurious deletions here.
    """

    if not base_sha:
        return []

    result = subprocess.run(
        [
            "git",
            "--git-dir",
            str(dotfiles_dir),
            "--work-tree",
            str(home),
            "diff",
            "--name-only",
            base_sha,
        ],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        return []
    return [pathlib.Path(line) for line in result.stdout.splitlines() if line]


def _deployed_digests(
    dotfiles_dir: pathlib.Path,
    sha: str,
    paths: Iterable[pathlib.Path],
) -> dict[pathlib.Path, str]:
    """SHA-256 of the content each of paths has at commit sha.

    A path that is not a file at sha, or that cannot be read, is left out, so
    callers treat it as unverifiable.
    """

    paths = list(paths)
    if not sha or not paths:
        return {}
    result = subprocess.run(
        ["git", "--git-dir", str(dotfiles_dir), "cat-file", "--batch"],
        input="".join(f"{sha}:{rel.as_posix()}\n" for rel in paths).encode(),
        capture_output=True,
    )
    if result.returncode != 0:
        return {}
    digests: dict[pathlib.Path, str] = {}
    output, offset = result.stdout, 0
    for rel in paths:
        end = output.index(b"\n", offset)
        header = output[offset:end].split()
        offset = end + 1
        if len(header) != 3:
            continue
        size = int(header[2])
        if header[1] == b"blob":
            digests[rel] = _sha256(output[offset : offset + size])
        offset += size + 1
    return digests


def _matches_digest(path: pathlib.Path, digest: str | None) -> bool:
    """Whether path is a regular file whose content has SHA-256 digest."""

    try:
        return (
            digest is not None
            and path.is_file()
            and not path.is_symlink()
            and _sha256(path.read_bytes()) == digest
        )
    except OSError:
        return False


def _discarded_commits(
    dotfiles_dir: pathlib.Path,
    kept_sha: str,
    dropped_sha: str,
) -> list[str]:
    """One-line summaries of commits reachable from dropped_sha but not
    kept_sha. These are local commits that advancing to the remote tip would
    drop."""

    if not kept_sha or not dropped_sha or kept_sha == dropped_sha:
        return []

    result = subprocess.run(
        [
            "git",
            "--git-dir",
            str(dotfiles_dir),
            "log",
            "--oneline",
            f"{kept_sha}..{dropped_sha}",
        ],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        return []
    return [line for line in result.stdout.splitlines() if line]


def _report_pending_loss(
    worktree_mods: list[pathlib.Path],
    discarded: list[str],
    home: pathlib.Path,
) -> None:
    """Print the local changes a destructive command is about to drop.

    Two independent categories, either of which may be empty:
    - worktree_mods: tracked dotfiles in HOME with uncommitted edits. Only
      --uninstall reports these. --update autostashes them instead, as handled
      by _reapply_stashed.
    - discarded: one-line summaries of local commits not on the remote, which
      --update would drop.
    """

    err_console.print(
        "\n[bold yellow]⚠  This would discard the following local changes:[/bold yellow]"
    )
    if worktree_mods:
        err_console.print("[yellow]  Uncommitted edits to tracked files:[/yellow]")
        for path in worktree_mods:
            err_console.print(f"    [dim]{path}[/dim]")
    if discarded:
        err_console.print("[yellow]  Local commits not present on the remote:[/yellow]")
        for line in discarded:
            err_console.print(f"    [dim]{line}[/dim]")
    err_console.print()


def _confirm_override(force: bool) -> bool:
    """Ask whether to overwrite local changes; defaults to no.

    Force, passed by --force, short-circuits to yes. A non-interactive stdin
    can never answer the prompt, so it defaults to no and asks for --force.
    """

    if force:
        return True
    if not sys.stdin.isatty():
        err_console.print(
            "[yellow]==> Non-interactive shell: refusing to discard local changes. "
            "Re-run with --force to override.[/yellow]"
        )
        return False
    try:
        answer = input("Override local changes and lose them? [y/N] ")
    except EOFError:
        return False
    return answer.strip().lower() in {"y", "yes"}


def _snapshot_worktree_files(
    home: pathlib.Path,
    paths: list[pathlib.Path],
) -> dict[pathlib.Path, bytes | None]:
    """Read the current HOME content of paths.

    --update uses this snapshot to reapply the user's uncommitted edits after
    the re-checkout (autostash semantics).

    Read now, before the re-checkout overwrites the files. A path the user has
    locally deleted is recorded as None so the deletion can be reapplied
    too.
    """

    snapshot: dict[pathlib.Path, bytes | None] = {}
    for rel in paths:
        target = home / rel
        try:
            snapshot[rel] = target.read_bytes() if target.is_file() else None
        except OSError:
            snapshot[rel] = None
    return snapshot


def _remote_changed_paths(
    dotfiles_dir: pathlib.Path,
    pre_sha: str,
    post_sha: str,
) -> set[pathlib.Path]:
    """Tracked paths whose content changed between pre_sha and post_sha.

    These are the files the pull itself touched, i.e. the ones where a local
    edit collides with an incoming change.
    """

    if not pre_sha or not post_sha or pre_sha == post_sha:
        return set()

    result = subprocess.run(
        [
            "git",
            "--git-dir",
            str(dotfiles_dir),
            "diff",
            "--name-only",
            pre_sha,
            post_sha,
        ],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        return set()
    return {pathlib.Path(line) for line in result.stdout.splitlines() if line}


def _reapply_stashed(
    stashed: dict[pathlib.Path, bytes | None],
    remote_changed: set[pathlib.Path],
    home: pathlib.Path,
    backup_dir: pathlib.Path,
) -> tuple[list[pathlib.Path], list[tuple[pathlib.Path, pathlib.Path]]]:
    """Re-apply the user's autostashed edits after the re-checkout.

    For a file the pull did NOT touch, the edit is written straight back, so the
    working tree looks exactly as it did before the update. If the incoming file
    already equals the stashed edit, the change has converged and needs no
    action. For a genuinely divergent file the pull also changed, the incoming
    version stays in HOME and the user's edit is parked in backup_dir under a
    distinct .local name instead: nothing is lost and no half-merged file
    with conflict markers is ever produced.

    Returns preserved paths and collisions. Each collision pairs the path with
    the backup file that now holds the user's edit.
    """

    preserved: list[pathlib.Path] = []
    conflicts: list[tuple[pathlib.Path, pathlib.Path]] = []
    for rel, content in stashed.items():
        target = home / rel
        incoming = target.read_bytes() if target.is_file() else None
        if content == incoming:
            continue

        if rel in remote_changed:
            # Keep the pulled file in HOME, and park the user's edit under a
            # name that never clobbers the pristine bootstrap backup.
            if content is not None:
                dst = _unique_local_backup(backup_dir, rel)
                dst.parent.mkdir(parents=True, exist_ok=True)
                dst.write_bytes(content)
                conflicts.append((rel, dst))
            continue

        # No incoming change touched this path, so restore the user's edit verbatim.
        if content is None:
            target.unlink(missing_ok=True)
        else:
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_bytes(content)
        preserved.append(rel)
    return preserved, conflicts


def _retire_untracked(
    untracked: list[pathlib.Path],
    deployed: dict[pathlib.Path, str],
    home: pathlib.Path,
    backup_dir: pathlib.Path,
    rollback: RollbackStack,
) -> tuple[list[pathlib.Path], list[pathlib.Path]]:
    """Clean up the dotfiles that are no longer tracked.

    A file whose content still matches its last deployed version in deployed
    is removed from HOME, and the original it replaced is moved back from
    backup_dir. Any other file, including one that cannot be verified, is left
    in place and becomes the user's together with its original. Returns the
    removed paths and the kept paths.
    """

    removed: list[pathlib.Path] = []
    kept: list[pathlib.Path] = []
    for rel in untracked:
        target = home / rel
        if target.exists() or target.is_symlink():
            if not _matches_digest(target, deployed.get(rel)):
                kept.append(rel)
                continue

            content = target.read_bytes()
            target.unlink()

            def _rewrite(
                target: pathlib.Path = target, content: bytes = content
            ) -> None:
                """Restore the removed tracked file if the update rolls back."""

                target.parent.mkdir(parents=True, exist_ok=True)
                target.write_bytes(content)

            rollback.push(f"restore {rel}", _rewrite)
            removed.append(rel)
        original = backup_dir / rel
        if original.exists() or original.is_symlink():
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.move(str(original), str(target))

            def _undo(
                original: pathlib.Path = original, target: pathlib.Path = target
            ) -> None:
                """Move the restored original back to the backup on rollback."""

                original.parent.mkdir(parents=True, exist_ok=True)
                shutil.move(str(target), str(original))

            rollback.push(f"move {rel} back to the backup", _undo)
            if rel not in removed:
                removed.append(rel)
    return removed, kept


def _notify_untracked(
    removed: list[pathlib.Path],
    kept: list[pathlib.Path],
    home: pathlib.Path,
    backup_dir: pathlib.Path,
) -> None:
    """Report the dotfiles that are no longer tracked."""

    if removed:
        console.print(f"==> Removed {len(removed)} file(s) that are no longer tracked:")
        for rel in removed:
            console.print(f"   [dim]{home / rel}[/dim]")
    if kept:
        console.print(
            f"[yellow]==> Kept {len(kept)} modified file(s) that are no longer "
            "tracked, they are yours now:[/yellow]"
        )
        for rel in kept:
            original = backup_dir / rel
            suffix = (
                f" (original in [cyan]{original}[/cyan])" if original.exists() else ""
            )
            console.print(f"   [dim]{home / rel}[/dim]{suffix}")


def _unique_local_backup(backup_dir: pathlib.Path, rel: pathlib.Path) -> pathlib.Path:
    """Return a backup path for a collided local edit.

    It never overwrites an existing file. The pristine bootstrap backup stays
    at backup_dir / rel.
    """

    candidate = backup_dir / rel.parent / f"{rel.name}.local"
    counter = 1
    while candidate.exists():
        candidate = backup_dir / rel.parent / f"{rel.name}.local.{counter}"
        counter += 1
    return candidate


def _notify_autostash(
    preserved: list[pathlib.Path],
    conflicts: list[tuple[pathlib.Path, pathlib.Path]],
    home: pathlib.Path,
) -> None:
    """Report which local edits --update kept in place and which it parked."""

    if preserved:
        console.print(
            f"==> [green]Kept {len(preserved)} local edit(s)[/green] across the update:"
        )
        for rel in preserved:
            console.print(f"    [dim]{home / rel}[/dim]")
    if conflicts:
        err_console.print(
            f"\n[bold yellow]⚠  {len(conflicts)} local edit(s) collided with an "
            "incoming change[/bold yellow]"
        )
        err_console.print(
            "[yellow]  The updated version was kept; your edit was saved to:[/yellow]"
        )
        for rel, dst in conflicts:
            err_console.print(f"    [dim]{home / rel}[/dim] -> [cyan]{dst}[/cyan]")
        err_console.print()


# ===============
# Ephemeral shell
# ===============

EPHEMERAL_DIR_NAME = "diegoferigo-dotfiles"


class SharedAuth(NamedTuple):
    """A tool login kept below the cache and shared by the ephemeral shells."""

    directory: str
    variable: str
    filename: str | None = None

    def path(self, cache: pathlib.Path) -> pathlib.Path:
        """The login location: the file when there is a filename, else the directory."""

        directory = cache / self.directory
        return directory / self.filename if self.filename else directory


_SHARED_AUTH = (
    SharedAuth("gh", "GH_CONFIG_DIR"),
    SharedAuth("gcloud", "CLOUDSDK_CONFIG"),
    SharedAuth("rattler", "RATTLER_AUTH_FILE", "credentials.json"),
)

_EPHEMERAL_UNSET_ENV = (
    "PIXI_HOME",
    "XDG_CONFIG_HOME",
    "XDG_DATA_HOME",
    "XDG_STATE_HOME",
    # The shebang's pixi exec sets these for the launcher itself, not for the
    # throwaway shell that bootstraps its own environment below HOME.
    "PIXI_ENVIRONMENT_NAME",
    "CONDA_PREFIX",
    "CONDA_SHLVL",
)


def ephemeral_base(home: pathlib.Path, environ: Mapping[str, str]) -> pathlib.Path:
    """Directory holding the shared cache and the per-session run directories."""

    cache_home = environ.get("XDG_CACHE_HOME")
    root = pathlib.Path(cache_home) if cache_home else home / ".cache"
    return root / EPHEMERAL_DIR_NAME


def ephemeral_env(
    *,
    home: pathlib.Path,
    cache: pathlib.Path,
    environ: Mapping[str, str],
) -> dict[str, str]:
    """Environment that redirects every per-user path of the session below home."""

    env = {k: v for k, v in environ.items() if k not in _EPHEMERAL_UNSET_ENV}
    env["HOME"] = str(home)
    env["XDG_CACHE_HOME"] = str(cache)
    env["RATTLER_CACHE_DIR"] = str(cache / "rattler")
    env["PIXI_CACHE_DIR"] = str(cache / "pixi")
    for auth in _SHARED_AUTH:
        env[auth.variable] = str(auth.path(cache))
    return env


def _process_is_alive(pid: int) -> bool:
    """Return whether pid still exists from this process's point of view."""

    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def sweep_stale_runs(base: pathlib.Path) -> list[pathlib.Path]:
    """Remove run directories whose owning process (the name prefix) is gone."""

    runs = base / "run"
    removed: list[pathlib.Path] = []
    if not runs.is_dir():
        return removed
    for run_dir in runs.iterdir():
        owner = run_dir.name.partition("-")[0]
        if owner.isdigit() and _process_is_alive(int(owner)):
            continue
        shutil.rmtree(run_dir, ignore_errors=True)
        removed.append(run_dir)
    return removed


@contextlib.contextmanager
def _ephemeral_lock(base: pathlib.Path) -> Iterator[None]:
    """Serialize run directory creation and the last-session check across shells."""

    base.mkdir(mode=0o700, parents=True, exist_ok=True)
    with (base / ".lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def _remove_shared_auth_if_unused(base: pathlib.Path) -> None:
    """Delete the shared tool logins when no ephemeral shell is left running."""

    sweep_stale_runs(base)
    runs = base / "run"
    if runs.is_dir() and any(runs.iterdir()):
        return

    for auth in _SHARED_AUTH:
        path = auth.path(base / "cache")
        if auth.filename:
            path.unlink(missing_ok=True)
            continue

        shutil.rmtree(path, ignore_errors=True)


def _controlling_tty(path: str = "/dev/tty", stdin_fd: int = 0) -> IO[bytes] | None:
    """Return the terminal to give the shell when stdin is not one, such as curl | bash."""

    if os.isatty(stdin_fd):
        return None
    try:
        return pathlib.Path(path).open("r+b", buffering=0)
    except OSError:
        return None


def _exit_on_signal(signum: int, _frame: object) -> None:
    """Exit with the conventional shell status for a fatal signal."""

    raise SystemExit(128 + signum)


def run_ephemeral_shell(
    *,
    base: pathlib.Path,
    repo_uri: str,
    skip_tools: bool,
    use_cache: bool,
    environ: Mapping[str, str],
    shell_cmd: list[str] | None = None,
    branch: str | None = None,
) -> int:
    """Bootstrap the dotfiles into a throwaway HOME, run a shell there, then delete it.

    Nothing outside base is written. The run directory is removed when the shell
    ends, including on SIGHUP and SIGTERM; a run killed without a chance to clean up
    is removed by the next call. The package cache lives in base/cache unless
    use_cache is false, in which case it is deleted with the run directory.
    The tool logins in _SHARED_AUTH (gh, gcloud, rattler) are shared by the running
    shells and deleted when the last one ends.
    """

    runs = base / "run"
    runs.mkdir(mode=0o700, parents=True, exist_ok=True)
    # Install cleanup-friendly signal handlers before the run directory exists.
    previous = {
        sig: signal.signal(sig, _exit_on_signal)
        for sig in (signal.SIGHUP, signal.SIGTERM)
    }
    run_dir: pathlib.Path | None = None
    try:
        with _ephemeral_lock(base):
            _remove_shared_auth_if_unused(base)
            run_dir = pathlib.Path(tempfile.mkdtemp(prefix=f"{os.getpid()}-", dir=runs))
            home = run_dir / "home"
            home.mkdir()
            # Keep no-cache sessions self-contained under the run directory for one-shot cleanup.
            cache = base / "cache" if use_cache else run_dir / "cache"
            cache.mkdir(parents=True, exist_ok=True)
        env = ephemeral_env(home=home, cache=cache, environ=environ)
        bootstrap = [
            sys.executable,
            str(pathlib.Path(__file__).resolve()),
            "--repo-uri",
            repo_uri,
            "--overwrite-git-dir",
        ]
        if skip_tools:
            bootstrap.append("--skip-tools")
        if branch:
            bootstrap.extend(["--branch", branch])
        status = subprocess.run(bootstrap, env=env, check=False).returncode
        if status != 0:
            return status

        console.print(
            f"==> Ephemeral shell in [cyan]{home}[/cyan]. "
            "Run 'dotfiles secrets apply' to load your secrets. "
            f"Exiting removes it; the cache stays in [cyan]{cache}[/cyan]."
            if use_cache
            else f"==> Ephemeral shell in [cyan]{home}[/cyan], with no cache kept. "
            "Run 'dotfiles secrets apply' to load your secrets."
        )
        shell = shell_cmd or ["bash", "--rcfile", str(home / ".bashrc"), "-i"]
        previous_int = signal.signal(signal.SIGINT, signal.SIG_IGN)
        tty = _controlling_tty()
        try:
            return subprocess.run(
                shell,
                env=env,
                check=False,
                stdin=tty,
                preexec_fn=lambda: signal.signal(signal.SIGINT, signal.SIG_DFL),
            ).returncode
        finally:
            signal.signal(signal.SIGINT, previous_int)
            if tty is not None:
                tty.close()
    finally:
        for sig in previous:
            signal.signal(sig, signal.SIG_IGN)
        try:
            if run_dir is not None:
                with _ephemeral_lock(base):
                    shutil.rmtree(run_dir, ignore_errors=True)
                    _remove_shared_auth_if_unused(base)
        finally:
            for sig, handler in previous.items():
                signal.signal(sig, handler)


# ===========
# Entry point
# ===========


def update(
    dotfiles_dir: pathlib.Path,
    home: pathlib.Path,
    backup_dir: pathlib.Path,
    force: bool = False,
    with_secrets: bool = False,
) -> int:
    """Pull latest changes from remote, re-apply sparse-checkout rules, and re-checkout dotfiles.

    Covers two concerns in one command:
    - Keeping dotfiles in sync with the remote repo (feature: dotfiles update).
    - Re-applying sparse-checkout rules after they change in a new version of this script.

    The re-checkout is guarded by a RollbackStack so a mid-way failure restores
    the previous work-tree state and ~/.bashrc instead of leaving HOME
    half-migrated.

    Uncommitted edits to tracked dotfiles are preserved automatically (autostash
    semantics): they are snapshotted before the re-checkout and written back
    after it. An edit that collides with a file the pull also changed is not
    merged. The incoming version wins in HOME and the user's edit is parked in
    backup_dir. The only genuinely destructive case left is a local commit that
    is not on the remote. --update reports it and asks for confirmation by
    default, and force from --force skips that prompt and drops it.
    """

    if not dotfiles_dir.exists():
        err_console.print(f"[red]==> dotfiles dir not found: {dotfiles_dir}[/red]")
        err_console.print("[red]==> Run without --update first to bootstrap.[/red]")
        return 1

    try:
        staged = _staged_paths(dotfiles_dir)
        if staged:
            paths = "\n".join(f"  {path}" for path in staged)
            raise RuntimeError(
                f"Refusing to update with staged changes:\n{paths}\n"
                "Commit or unstage them before updating."
            )
        previous_manifest = _read_manifest(dotfiles_dir)
        backup_dir = _manifest_backup_dir(previous_manifest, backup_dir)
        secret_targets = frozenset(
            pathlib.Path(rel) for rel in _secret_entries(previous_manifest)
        )
        previous_checked_out = previous_manifest.get("checked_out", [])
        if not isinstance(previous_checked_out, list) or not all(
            isinstance(path, str) for path in previous_checked_out
        ):
            raise RuntimeError("Invalid checked_out section in manifest")
        managed = frozenset(pathlib.Path(path) for path in previous_checked_out)
        previous_backed_up = previous_manifest.get("backed_up", [])
        if not isinstance(previous_backed_up, list) or not all(
            isinstance(path, str) for path in previous_backed_up
        ):
            raise RuntimeError("Invalid backed_up section in manifest")
        already_reported = frozenset(pathlib.Path(p) for p in previous_backed_up)
    except Exception as exc:
        err_console.print(f"[red]==> {describe_error(exc)}[/red]")
        return 1

    console.print("==> Pulling latest dotfiles from remote")

    # Capture HEAD before fetching so rollback can restore the old tree and a
    # no-op update can be reported accurately.
    pre_sha = _git_head_sha(dotfiles_dir)

    # Snapshot the state that re-checkout would clobber before touching refs.
    # Compare against pre_sha so remote-only changes are not mistaken for local
    # edits, then save the file content needed to replay those edits later.
    branch = _current_branch(dotfiles_dir)
    worktree_mods = _local_modifications(dotfiles_dir, home, pre_sha)
    stashed = _snapshot_worktree_files(home, worktree_mods)

    # git pull needs a work-tree, and git clone --bare leaves remote.origin.fetch
    # empty. A plain fetch would only move FETCH_HEAD, so fetch the branch tip
    # explicitly and decide whether it is safe to advance before moving refs.
    target_sha, fetch_err = _fetch_remote_tip(dotfiles_dir, branch)
    if not target_sha:
        err_console.print(f"[red]==> git fetch failed:\n{fetch_err}[/red]")
        return 1

    # Uncommitted edits are autostashed below, so only dropped local commits
    # still need consent here.
    discarded = _discarded_commits(dotfiles_dir, target_sha, pre_sha)

    if discarded:
        _report_pending_loss([], discarded, home)
        if not _confirm_override(force):
            # HEAD has not moved yet, so aborting needs no ref surgery.
            console.print("[yellow]==> Update aborted; no changes made.[/yellow]")
            return 1

    # Keep HEAD on pre_sha until consent is settled, so an early abort leaves
    # the repo exactly as it was.
    if branch and target_sha != pre_sha:
        advanced = subprocess.run(
            [
                "git",
                "--git-dir",
                str(dotfiles_dir),
                "update-ref",
                f"refs/heads/{branch}",
                target_sha,
            ],
            capture_output=True,
            text=True,
        )
        if advanced.returncode != 0:
            err_console.print(
                f"[red]==> failed to advance {branch} to the remote tip:\n"
                f"{advanced.stderr}[/red]"
            )
            return 1

    post_sha = _git_head_sha(dotfiles_dir)

    # A local edit on one of these paths collides with an incoming change, so it
    # must be parked instead of being written back over the pull result.
    remote_changed = _remote_changed_paths(dotfiles_dir, pre_sha, post_sha)

    # Warn when local HEAD tracks a branch other than the remote default, and
    # report whether the fetch changed anything.
    _warn_update_branch_mismatch(dotfiles_dir)
    if pre_sha and pre_sha == post_sha:
        console.print("[green]==> Already up to date.[/green]")
    else:
        console.print(
            f"[green]==> Updated {pre_sha[:9] or '?'} → {post_sha[:9] or '?'}[/green]"
        )

    repo = git.Repo(str(dotfiles_dir))

    rollback = RollbackStack()
    try:
        # Re-apply sparse-checkout rules so a newly pulled script can change
        # which tracked development files stay out of HOME.
        DotfilesRepo.configure_sparse_checkout(repo=repo)

        bashrc = home / ".bashrc"
        bashrc_original = (
            bashrc.read_text(encoding="utf-8") if bashrc.exists() else None
        )

        def _restore_worktree() -> None:
            """Restore HOME to the pre-update tree, including autostashed edits."""

            # Re-check out the previous tree via copy, mirroring
            # checkout_to_home's strategy for excluded files such as ~/.bashrc.
            if not pre_sha:
                return
            with DotfilesRepo._sparse_worktree(str(dotfiles_dir), pre_sha) as (
                worktree,
                files,
            ):
                DotfilesRepo._copy_into_home(worktree, files, home)
            DotfilesRepo._populate_index(str(dotfiles_dir), home, files)
            for rel, content in stashed.items():
                target = home / rel
                if content is None:
                    target.unlink(missing_ok=True)
                else:
                    target.parent.mkdir(parents=True, exist_ok=True)
                    target.write_bytes(content)

        def _restore_bashrc() -> None:
            """Put ~/.bashrc back exactly as it was before the update."""

            if bashrc_original is None:
                bashrc.unlink(missing_ok=True)
            else:
                bashrc.write_text(bashrc_original, encoding="utf-8")

        # Push in reverse order so rollback restores the work-tree before .bashrc.
        rollback.push("restore .bashrc", _restore_bashrc)
        rollback.push("restore work-tree to pre-update state", _restore_worktree)

        backed_up, checked_out = DotfilesRepo.checkout_to_home(
            repo=repo,
            home=home,
            backup_dir=backup_dir,
            managed=managed,
            forbidden=secret_targets,
        )

        preserved, conflicts = _reapply_stashed(
            stashed, remote_changed, home, backup_dir
        )

        Bashrc.inject(home, *Bashrc.read_blocks(home))

        # Last before write_manifest(), so a failure above cannot roll back
        # against already-updated ownership data.
        # Retire no-longer-tracked files while the pre-update manifest still
        # describes what HOME owns.
        untracked = sorted(managed - set(checked_out) - secret_targets)
        removed, kept = _retire_untracked(
            untracked,
            _deployed_digests(dotfiles_dir, pre_sha, untracked),
            home,
            backup_dir,
            rollback,
        )

        write_manifest(
            dotfiles_dir=dotfiles_dir,
            backup_dir=backup_dir,
            backed_up=backed_up,
            checked_out=checked_out,
        )

        # The manifest keeps every backup for uninstall, so only new ones
        # should be reported here.
        notify_backups(
            [rel for rel in backed_up if rel not in already_reported],
            home=home,
            backup_dir=backup_dir,
        )
        _notify_autostash(preserved, conflicts, home)
        _notify_untracked(removed, kept, home, backup_dir)
    except Exception as exc:
        err_console.print(f"\n[red]==> {describe_error(exc)}[/red]")
        rollback.rollback()
        return 1

    if with_secrets:
        try:
            apply_secrets(dotfiles_dir, home, backup_dir, force=force)
        except Exception as exc:
            err_console.print(f"[red]==> {describe_error(exc)}[/red]", soft_wrap=True)
            return 1
    else:
        _notify_encrypted_sources(dotfiles_dir)
    console.print("[bold green]==> Update complete.[/bold green]")
    return 0


def _secret_uninstall_conflicts(
    entries: dict[str, dict[str, str]],
    home: pathlib.Path,
) -> tuple[list[pathlib.Path], list[pathlib.Path]]:
    """Return modified files and directory collisions for deployed secrets."""

    modified: list[pathlib.Path] = []
    directories: list[pathlib.Path] = []
    for rel, entry in entries.items():
        target = home / rel
        if target.is_dir():
            directories.append(pathlib.Path(rel))
        elif target.is_symlink() or (
            target.is_file()
            and entry["plaintext_sha256"] != _sha256(target.read_bytes())
        ):
            modified.append(pathlib.Path(rel))
    return modified, directories


def _uninstall_secrets(
    entries: dict[str, dict[str, str]],
    home: pathlib.Path,
    backup_dir: pathlib.Path,
) -> None:
    """Remove unchanged deployed secrets from HOME and restore pristine backups."""

    console.print("==> Removing decrypted dotfiles")
    for rel in entries:
        rel_path = pathlib.Path(rel)
        target = home / rel_path
        target.unlink(missing_ok=True)
        backup = backup_dir / rel_path
        if backup.exists():
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.move(str(backup), str(target))


def uninstall(
    dotfiles_dir: pathlib.Path,
    home: pathlib.Path,
    force: bool = False,
) -> int:
    """Remove checked-out dotfiles and restore backed-up files using manifest.json.

    Removing a tracked dotfile from HOME drops any uncommitted edit the user made
    to it (the backup dir only holds the pristine pre-bootstrap copy), so the same
    override guard as --update applies here before anything is deleted.
    """

    manifest_path = dotfiles_dir / "manifest.json"
    if not manifest_path.exists():
        err_console.print(f"[red]==> manifest not found: {manifest_path}[/red]")
        return 1

    manifest = _read_manifest(dotfiles_dir)
    backup_value = manifest.get("backup_dir")
    checked_value = manifest.get("checked_out")
    backed_value = manifest.get("backed_up")
    if (
        not isinstance(backup_value, str)
        or not isinstance(checked_value, list)
        or not all(isinstance(path, str) for path in checked_value)
        or not isinstance(backed_value, list)
        or not all(isinstance(path, str) for path in backed_value)
    ):
        err_console.print(f"[red]==> invalid manifest: {manifest_path}[/red]")
        return 1
    backup_dir = pathlib.Path(backup_value)
    checked_out = [pathlib.Path(p) for p in checked_value]
    backed_up = [pathlib.Path(p) for p in backed_value]

    worktree_mods = _local_modifications(
        dotfiles_dir, home, _git_head_sha(dotfiles_dir)
    )
    secret_entries = _secret_entries(manifest)
    secret_mods, secret_directories = _secret_uninstall_conflicts(secret_entries, home)
    if secret_directories:
        paths = "\n".join(f"  {home / path}" for path in secret_directories)
        err_console.print(
            "[red]==> Refusing to uninstall secret targets occupied by directories:"
            f"\n{paths}[/red]"
        )
        return 1
    pending_loss = [*worktree_mods, *secret_mods]
    if pending_loss:
        _report_pending_loss(pending_loss, [], home)
        if not _confirm_override(force):
            console.print("[yellow]==> Uninstall aborted; no changes made.[/yellow]")
            return 1

    console.print("==> Removing checked-out dotfiles from HOME")
    for rel in checked_out:
        target = home / rel
        if target.is_file() or target.is_symlink():
            target.unlink()

    if backed_up:
        console.print("==> Restoring backed-up files")
        for rel in backed_up:
            src = backup_dir / rel
            dst = home / rel
            if src.exists():
                dst.parent.mkdir(parents=True, exist_ok=True)
                shutil.move(str(src), str(dst))
                console.print(f"   [cyan]{src}[/cyan]  →  [dim]{dst}[/dim]")

    _uninstall_secrets(secret_entries, home, backup_dir)

    console.print(f"==> Removing dotfiles directory {dotfiles_dir}")
    shutil.rmtree(dotfiles_dir, ignore_errors=True)

    Bashrc.remove_blocks(home)

    # Remove backup_dir when it is empty, otherwise list unrestored files so
    # they are not silently lost.
    if backup_dir.exists() and not any(backup_dir.iterdir()):
        backup_dir.rmdir()
    elif backup_dir.exists():
        leftovers = sorted(p for p in backup_dir.rglob("*") if not p.is_dir())
        if leftovers:
            console.print(
                f"[yellow]==> {len(leftovers)} file(s) were not restored and remain "
                f"in [cyan]{backup_dir}[/cyan]:[/yellow]"
            )
            for path in leftovers:
                console.print(f"   [dim]{path}[/dim]")

    console.print("[bold green]==> Uninstall complete.[/bold green]")
    return 0


def install_nerd_fonts(
    home: pathlib.Path,
    *,
    font_keys: Iterable[str] | None = None,
) -> None:
    """Download, verify, and install one or more pinned Nerd Font Mono families."""

    selected_specs = [
        NERD_FONTS[key] for key in (font_keys if font_keys is not None else NERD_FONTS)
    ]
    installed_dirs = [
        install_nerd_font(home=home, spec=spec) for spec in selected_specs
    ]

    fc_cache = shutil.which("fc-cache")
    if fc_cache is None:
        console.print(
            "[yellow]==> fc-cache not found. Refresh the font cache manually if "
            "your system needs it.[/yellow]"
        )
    else:
        for target_dir in installed_dirs:
            console.print(f"==> Refreshing font cache for [cyan]{target_dir}[/cyan]")
            subprocess.run([fc_cache, "-f", str(target_dir)], check=True)

    console.print(
        "==> Terminals and Zed load fonts at startup. Restart them after "
        "selecting the font."
    )


def install_nerd_font(*, home: pathlib.Path, spec: NerdFontSpec) -> pathlib.Path:
    """Download, verify, and install one pinned Nerd Font Mono family."""

    target_dir = home / spec.target_dir
    target_parent = target_dir.parent
    target_parent.mkdir(parents=True, exist_ok=True)

    console.print(
        f"==> Downloading {spec.display_name} from [cyan]{spec.archive_url}[/cyan]",
        soft_wrap=True,
    )
    with tempfile.TemporaryDirectory(prefix="dotfiles-fonts-") as archive_tmp_root_name:
        archive_tmp_root = pathlib.Path(archive_tmp_root_name)
        archive_path = archive_tmp_root / _font_archive_name(spec.archive_url)
        size_bytes, actual_sha256 = _download_url_to_path(
            url=spec.archive_url,
            destination=archive_path,
            expected_size_bytes=spec.archive_size_bytes,
        )

        if size_bytes != spec.archive_size_bytes:
            raise RuntimeError(
                f"{spec.display_name} archive size mismatch: "
                f"expected {spec.archive_size_bytes} bytes, got {size_bytes}"
            )

        if actual_sha256 != spec.archive_sha256:
            raise RuntimeError(
                f"{spec.display_name} archive checksum mismatch: "
                f"expected {spec.archive_sha256}, got {actual_sha256}"
            )

        console.print(
            f"==> Verified archive size and sha256: {size_bytes} bytes, "
            f"{actual_sha256}"
        )
        staging_root = pathlib.Path(
            tempfile.mkdtemp(
                dir=target_parent,
                prefix=f".{target_dir.name}.",
            )
        )
        try:
            staged_dir = staging_root / target_dir.name
            installed = _extract_nerd_font(
                archive_path=archive_path,
                destination=staged_dir,
                spec=spec,
            )
            _replace_directory(
                src=staged_dir,
                dst=target_dir,
                backup_root=staging_root,
            )
        finally:
            shutil.rmtree(staging_root, ignore_errors=True)

    console.print(
        f"==> Installed {len(installed)} file(s) into [cyan]{target_dir}[/cyan]"
    )
    for name in installed:
        console.print(f"   [dim]{target_dir / name}[/dim]")

    console.print(f"==> Family name: [bold]{spec.family_name}[/bold]")
    return target_dir


# Private helpers


def _download_url_to_path(
    *,
    url: str,
    destination: pathlib.Path,
    expected_size_bytes: int,
    timeout_seconds: float = 30.0,
) -> tuple[int, str]:
    """Download url into destination without leaving a partial file behind."""

    destination.parent.mkdir(parents=True, exist_ok=True)
    digest = hashlib.sha256()
    with (
        urllib.request.urlopen(url, timeout=timeout_seconds) as response,  # noqa: S310
        tempfile.NamedTemporaryFile(
            dir=destination.parent,
            prefix=f"{destination.name}.",
            delete=False,
        ) as stream,
    ):
        tmp_path = pathlib.Path(stream.name)
        try:
            size_bytes = 0
            while True:
                chunk = response.read(64 * 1024)
                if not chunk:
                    break
                size_bytes += len(chunk)
                if size_bytes > expected_size_bytes:
                    raise RuntimeError(
                        f"Download exceeded expected size: "
                        f"{size_bytes} > {expected_size_bytes} bytes"
                    )
                stream.write(chunk)
                digest.update(chunk)
            tmp_path.replace(destination)
            return size_bytes, digest.hexdigest()
        except BaseException:
            tmp_path.unlink(missing_ok=True)
            raise


def _extract_nerd_font(
    *,
    archive_path: pathlib.Path,
    destination: pathlib.Path,
    spec: NerdFontSpec,
) -> list[str]:
    """Extract only the allowlisted mono fonts and the license."""

    destination.mkdir(parents=True, exist_ok=True)
    installed: list[str] = []
    members_to_install = [*spec.archive_members, spec.archive_license_member]

    with tarfile.open(archive_path, mode="r:xz") as archive:
        archive_members = {
            member.name: member for member in archive.getmembers() if member.isfile()
        }
        missing = [
            name for name in members_to_install if archive_members.get(name) is None
        ]
        if missing:
            raise RuntimeError(
                f"Missing archive member(s) for {spec.display_name}: "
                f"{', '.join(missing)}"
            )
        for name in members_to_install:
            member = archive_members[name]
            target_name = (
                "LICENSE" if name == spec.archive_license_member else name
            )
            stream = archive.extractfile(member)
            if stream is None:
                raise RuntimeError(f"Unable to read archive member: {name}")

            try:
                (destination / target_name).write_bytes(stream.read())
            finally:
                stream.close()
            installed.append(target_name)

    return installed


def _replace_directory(
    *,
    src: pathlib.Path,
    dst: pathlib.Path,
    backup_root: pathlib.Path,
) -> None:
    """Replace dst with src without leaving partial files behind."""

    backup_path = backup_root / f"{dst.name}.previous"
    shutil.rmtree(backup_path, ignore_errors=True)

    moved_previous = False
    try:
        if dst.exists():
            # Move the previous directory into the hidden staging area first so
            # a crash never leaves the target path empty without a recoverable
            # copy, and so fontconfig never scans the backup as a second family.
            dst.rename(backup_path)
            moved_previous = True
        src.rename(dst)
    except BaseException:
        if not dst.exists() and moved_previous and backup_path.exists():
            backup_path.rename(dst)
        raise
    else:
        if moved_previous:
            shutil.rmtree(backup_path, ignore_errors=True)


def _font_archive_name(url: str) -> str:
    """Return a usable local filename for one archive URL."""

    path = urllib.parse.urlparse(url).path
    name = pathlib.PurePosixPath(path).name
    if not name:
        raise RuntimeError(f"Unable to determine archive name from URL: {url}")
    return name


def main() -> int:
    """Parse arguments, run the full bootstrap flow, and rollback on any error."""

    home = pathlib.Path.home()
    dotfiles_dir = pathlib.Path(
        os.environ.get("DOTFILES_DIR", home / ".dotfiles")
    ).expanduser()
    backup_dir = pathlib.Path(
        os.environ.get("BACKUP_DIR", home / ".dotfiles_backup")
    ).expanduser()

    # Handled before the main parser: passthrough to the bare repo.
    if len(sys.argv) > 1 and sys.argv[1] == "git":
        return _run_git_passthrough(dotfiles_dir, home, sys.argv[2:])

    # Handled before the main parser: secrets has its own parser.
    if len(sys.argv) > 1 and sys.argv[1] == "secrets":
        secrets_parser = argparse.ArgumentParser(
            description="Manage encrypted dotfiles"
        )
        secrets_subparsers = secrets_parser.add_subparsers(
            dest="command", required=True
        )
        secrets_subparsers.add_parser("status", help="Show encrypted dotfile state")
        secrets_subparsers.add_parser(
            "init",
            help="Create and stage a passphrase-encrypted shared identity",
        )
        secrets_subparsers.add_parser(
            "change-passphrase",
            help="Change and stage the encrypted identity passphrase",
        )
        encrypt_parser = secrets_subparsers.add_parser(
            "encrypt",
            help="Encrypt and stage one file below HOME",
        )
        encrypt_parser.add_argument(
            "path",
            type=pathlib.Path,
            help="Plaintext file below HOME",
        )
        encrypt_parser.add_argument(
            "--resolve",
            action="store_true",
            help="Resolve a merge conflict for this ciphertext from the plaintext file",
        )
        apply_parser = secrets_subparsers.add_parser(
            "apply", help="Decrypt and deploy encrypted dotfiles"
        )
        apply_parser.add_argument(
            "--force",
            action="store_true",
            help="Overwrite locally modified decrypted files",
        )
        secrets_args = secrets_parser.parse_args(sys.argv[2:])
        try:
            if secrets_args.command == "status":
                return secret_status(dotfiles_dir, home, backup_dir)
            if secrets_args.command == "init":
                init_secret_identity(dotfiles_dir, home)
            elif secrets_args.command == "change-passphrase":
                change_secret_passphrase(dotfiles_dir, home)
            elif secrets_args.command == "encrypt":
                encrypt_secret(
                    dotfiles_dir,
                    home,
                    backup_dir,
                    secrets_args.path,
                    resolve=secrets_args.resolve,
                )
            else:
                apply_secrets(
                    dotfiles_dir,
                    home,
                    backup_dir,
                    force=secrets_args.force,
                )
            return 0  # noqa: TRY300  # Success must exit from the command boundary try.
        except Exception as exc:
            err_console.print(
                f"[red]==> {describe_error(exc)}[/red]",
                soft_wrap=True,
            )
            return 1

    # Handled before the main parser: fonts has its own parser.
    if len(sys.argv) > 1 and sys.argv[1] == "fonts":
        fonts_parser = argparse.ArgumentParser(
            description="Manage optional local fonts"
        )
        fonts_subparsers = fonts_parser.add_subparsers(dest="command", required=True)
        install_parser = fonts_subparsers.add_parser(
            "install",
            help="Download and install pinned Nerd Font Mono families into ~/.local/share/fonts",
        )
        install_parser.add_argument(
            "fonts",
            nargs="*",
            choices=tuple(NERD_FONTS),
            help="Fonts to install. Defaults to all known fonts.",
        )
        fonts_args = fonts_parser.parse_args(sys.argv[2:])
        try:
            if fonts_args.command == "install":
                install_nerd_fonts(home, font_keys=fonts_args.fonts or None)
            return 0  # noqa: TRY300  # Success must exit from the command boundary try.
        except Exception as exc:
            err_console.print(
                f"[red]==> {describe_error(exc)}[/red]",
                soft_wrap=True,
            )
            return 1

    parser = argparse.ArgumentParser(
        description="Bootstrap dotfiles",
        epilog="Use 'dotfiles git <args>' to run git against the bare repo.",
    )

    parser.add_argument(
        "--repo-uri",
        type=str,
        metavar="URI",
        default=os.environ.get("DOTFILES_REPO", None),
        help="URI of the dotfiles repo (file://abs/path, git://, https://); env: DOTFILES_REPO",
    )

    parser.add_argument(
        "--branch",
        type=str,
        metavar="NAME",
        default=os.environ.get("DOTFILES_BRANCH", None),
        help="Branch to clone instead of the remote default; env: DOTFILES_BRANCH",
    )

    parser.add_argument(
        "--origin-uri",
        type=str,
        metavar="URI",
        default=os.environ.get("DOTFILES_ORIGIN", None),
        help="URL to set as origin of the clone instead of the source; env: DOTFILES_ORIGIN",
    )

    parser.add_argument(
        "--overwrite-git-dir",
        action="store_true",
        help="Overwrite existing dotfiles git directory if it exists",
    )

    parser.add_argument(
        "--uninstall",
        action="store_true",
        help="Remove dotfiles and restore backed-up files using the manifest",
    )

    parser.add_argument(
        "--update",
        action="store_true",
        help="Pull latest changes from remote, re-apply sparse-checkout, re-checkout dotfiles, then install any missing pixi global tools",
    )

    parser.add_argument(
        "--force",
        action="store_true",
        help="Override protected local changes during update, secret apply, or uninstall",
    )

    parser.add_argument(
        "--skip-tools",
        action="store_true",
        default=bool(os.environ.get("DOTFILES_SKIP_TOOLS")),
        help="Skip installing the pixi global tools; env: DOTFILES_SKIP_TOOLS",
    )

    parser.add_argument(
        "--with-secrets",
        action="store_true",
        help="Prompt for the encrypted identity and apply secrets after bootstrap or update",
    )

    parser.add_argument(
        "--shell",
        action="store_true",
        help="Bootstrap into a throwaway HOME, run a shell there and delete it on exit",
    )

    parser.add_argument(
        "--no-cache",
        action="store_true",
        help="With --shell, keep the package cache in the throwaway HOME too",
    )

    args = parser.parse_args()

    if args.shell:
        if args.uninstall or args.update or args.with_secrets:
            parser.error(
                "--shell cannot be used with --uninstall, --update or --with-secrets"
            )
        if not args.repo_uri:
            parser.error(
                "--shell needs --repo-uri or the DOTFILES_REPO environment variable"
            )
        return run_ephemeral_shell(
            base=ephemeral_base(home, os.environ),
            repo_uri=args.repo_uri,
            skip_tools=args.skip_tools,
            use_cache=not args.no_cache,
            environ=os.environ,
            branch=args.branch,
        )

    if args.uninstall:
        if args.with_secrets:
            parser.error("--with-secrets cannot be used with --uninstall")
        return uninstall(dotfiles_dir=dotfiles_dir, home=home, force=args.force)

    if args.update:
        status = update(
            dotfiles_dir=dotfiles_dir,
            home=home,
            backup_dir=backup_dir,
            force=args.force,
            with_secrets=args.with_secrets,
        )
        if status == 0:
            install_tools_or_warn(skip=args.skip_tools)
            install_lazy_tools_or_warn(skip=args.skip_tools, home=home)
            setup_herdr_or_warn(skip=args.skip_tools, home=home)
        return status

    if not args.repo_uri:
        msg = "Missing repo URI, pass --repo-uri or set DOTFILES_REPO environment variable"
        raise argparse.ArgumentError(None, msg)

    require_command("git")

    rollback = RollbackStack()

    try:
        dotfiles = DotfilesRepo(
            repo_uri=args.repo_uri,
            overwrite_git_dir=args.overwrite_git_dir,
            branch=args.branch,
            origin_uri=args.origin_uri,
        )

        rollback.push(
            description="remove dotfiles dir",
            fn=lambda: shutil.rmtree(dotfiles.dotfiles_dir, ignore_errors=True),
        )

        DotfilesRepo.configure_sparse_checkout(repo=dotfiles.repo)

        # Only paths still matching the last deployed content are ours to
        # replace automatically. An edited one is a normal user conflict.
        previous = dotfiles.previous_manifest
        dotfiles.backup_dir = _manifest_backup_dir(previous, dotfiles.backup_dir)
        previous_checked_out = _manifest_paths(previous, "checked_out")
        secret_targets = frozenset(
            pathlib.Path(rel) for rel in _secret_entries(previous)
        )
        managed = frozenset(
            rel
            for rel in previous_checked_out
            if _matches_digest(dotfiles.home / rel, dotfiles.previous_digests.get(rel))
        )
        previous_content = {rel: (dotfiles.home / rel).read_bytes() for rel in managed}

        backed_up, checked_out = DotfilesRepo.checkout_to_home(
            repo=dotfiles.repo,
            home=dotfiles.home,
            backup_dir=dotfiles.backup_dir,
            managed=managed,
            forbidden=secret_targets,
        )

        # Save rollback for the new checkout before later steps touch HOME.
        _home, _backup_dir, _backed_up = dotfiles.home, dotfiles.backup_dir, backed_up

        def _undo_checkout() -> None:
            """Remove the new checkout and put back the previous HOME state."""

            for rel in checked_out:
                target = _home / rel
                if rel in previous_content:
                    target.write_bytes(previous_content[rel])
                elif target.is_file() and not target.is_symlink():
                    target.unlink()
            for rel in _backed_up:
                src, dst = _backup_dir / rel, _home / rel
                if src.exists():
                    dst.parent.mkdir(parents=True, exist_ok=True)
                    shutil.move(str(src), str(dst))

        rollback.push(
            description="restore backed-up files and remove checked-out dotfiles",
            fn=_undo_checkout,
        )

        untracked = sorted(
            set(previous_checked_out) - set(checked_out) - secret_targets
        )
        removed, kept = _retire_untracked(
            untracked,
            dotfiles.previous_digests,
            dotfiles.home,
            dotfiles.backup_dir,
            rollback,
        )
        _notify_untracked(removed, kept, dotfiles.home, dotfiles.backup_dir)

        write_manifest(
            dotfiles_dir=dotfiles.dotfiles_dir,
            backup_dir=dotfiles.backup_dir,
            backed_up=backed_up,
            checked_out=checked_out,
        )

        notify_backups(
            backed_up,
            home=dotfiles.home,
            backup_dir=dotfiles.backup_dir,
        )

        # Save ~/.bashrc before injecting so rollback can restore it.
        _bashrc = dotfiles.home / ".bashrc"
        _bashrc_original = (
            _bashrc.read_text(encoding="utf-8") if _bashrc.exists() else None
        )
        Bashrc.inject(dotfiles.home, *Bashrc.read_blocks(dotfiles.home))

        def _restore_bashrc() -> None:
            """Put ~/.bashrc back exactly as it was before bootstrap."""

            if _bashrc_original is None:
                _bashrc.unlink(missing_ok=True)
            else:
                _bashrc.write_text(_bashrc_original, encoding="utf-8")

        rollback.push(description="restore .bashrc", fn=_restore_bashrc)

    except Exception as exc:
        err_console.print(f"\n[red]==> {describe_error(exc)}[/red]")
        rollback.rollback()
        return 1

    install_tools_or_warn(skip=args.skip_tools)
    install_lazy_tools_or_warn(skip=args.skip_tools, home=dotfiles.home)
    setup_herdr_or_warn(skip=args.skip_tools, home=dotfiles.home)

    if args.with_secrets:
        try:
            apply_secrets(
                dotfiles.dotfiles_dir,
                dotfiles.home,
                dotfiles.backup_dir,
                force=args.force,
            )
        except Exception as exc:
            err_console.print(f"[red]==> {describe_error(exc)}[/red]", soft_wrap=True)
            return 1
    else:
        _notify_encrypted_sources(dotfiles.dotfiles_dir)
    console.print("[bold green]==> Done![/bold green]")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
