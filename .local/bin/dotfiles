# Keep tracked development files out of HOME. The bare repo uses HOME as its
# work-tree, so any tracked path omitted here would deploy onto the machine.
SPARSE_TRACKED_EXCLUDES = (
    ".devcontainer",
    ".github",
    ".pixi",
    "tests",
    ".gitattributes",
    ".gitignore",
    ".pre-commit-config.yaml",
    "pyproject.toml",
    ".shellcheckrc",
    "AGENTS.md",
    "bootstrap",
    "LICENSE",
    "pixi.lock",
    "pixi.toml",
    "README.md",
    "secrets",
)

# Keep never-tracked gitignored paths out of HOME if one is ever re-added.
SPARSE_UNTRACKED_GUARDS = (".pytest_cache", ".ruff_cache", ".vscode")

SPARSE_CHECKOUT = (
    "\n".join(
        [
            "/*",
            *(
                f"!{path}"
                for path in (*SPARSE_TRACKED_EXCLUDES, *SPARSE_UNTRACKED_GUARDS)
            ),
        ]
    )
    + "\n"
)

