import git
import rich.console

console = rich.console.Console()
err_console = rich.console.Console(stderr=True)

TOOLS: list[str] = [
    "starship",
    "bat",
    "eza",
    "fzf",
    "fd-find",
    "zoxide",
    "difftastic",
    "age",
]

# Development files tracked in the repo but kept out of HOME.
SPARSE_TRACKED_EXCLUDES = (
    ".devcontainer",
    ".github",
    "tests",
    ".gitattributes",
    ".gitignore",
    ".pre-commit-config.yaml",
    ".shellcheckrc",
    "AGENTS.md",
    "bootstrap",
    "LICENSE",
    "pixi.lock",
    "pixi.toml",
    "README.md",
    "secrets",
)

# Gitignored paths that are never tracked but are still excluded, so that
# re-adding one later does not land it in HOME through the opt-out rule.
SPARSE_UNTRACKED_GUARDS = (".pixi", ".pytest_cache", ".ruff_cache", ".vscode")

SPARSE_CHECKOUT = "\n".join(
    ["/*", *(f"!{path}" for path in (*SPARSE_TRACKED_EXCLUDES, *SPARSE_UNTRACKED_GUARDS))]
) + "\n"


# =========
# Utilities
# =========


def describe_error(exc: BaseException) -> str:
    """Return a descriptive message for *exc*.

    A ``subprocess.CalledProcessError`` stringifies to just the command and the
    exit code, dropping the captured output: with ``capture_output=True`` that
    hides the actual git message and leaves a useless 'returned non-zero exit
    status 128'. Unpack it so the real stderr (and stdout) reach the user.
    """

    if not isinstance(exc, subprocess.CalledProcessError):
        return str(exc)

    def _clean(stream: object) -> str:
        if not stream:
            return ""
        text = stream.decode(errors="replace") if isinstance(stream, bytes) else str(stream)
        return text.strip()

    argv = exc.cmd
    cmd = " ".join(argv) if isinstance(argv, (list, tuple)) else str(argv)
    lines = [f"Command failed (exit {exc.returncode}): {cmd}"]
    stderr = _clean(exc.stderr)
    stdout = _clean(exc.stdout)
    if stderr:
        lines.append(stderr)
    if stdout:
        lines.append(stdout)

    return "\n".join(lines)


class Bashrc:
    """Namespace for ~/.bashrc injection operations."""

    BLOCK_BEGIN = "# >>> dotfiles >>>"
    BLOCK_END = "# <<< dotfiles <<<"
    DOTFILES_FILE = ".bashrc.dotfiles.sh"

    @staticmethod
    def read_block(home: pathlib.Path) -> str:
        """Build the inject block from ~/.bashrc.dotfiles.sh."""

        source = home / Bashrc.DOTFILES_FILE

        if not source.exists():
            raise RuntimeError(f"Source file not found: {source}")

        content = source.read_text(encoding="utf-8").rstrip("\n")

        return (
            f"{Bashrc.BLOCK_BEGIN}\n"
            f"# AUTO-GENERATED — edit ~/{Bashrc.DOTFILES_FILE} and run 'dotfiles --update'\n"
            f"{content}\n"
            f"{Bashrc.BLOCK_END}"
        )

    @staticmethod
    def inject(
        home: pathlib.Path,
        block: str,
    ) -> None:
        """Inject or update the dotfiles managed block in ~/.bashrc."""

        bashrc = home / ".bashrc"
        text = bashrc.read_text(encoding="utf-8") if bashrc.exists() else ""
        pattern = rf"{re.escape(Bashrc.BLOCK_BEGIN)}.*?{re.escape(Bashrc.BLOCK_END)}"
        new_text, n = re.subn(pattern, lambda _: block, text, flags=re.DOTALL)
        if n == 0:
            separator = "\n" if text.endswith("\n") else "\n\n" if text else ""
            new_text = text + separator + block + "\n"
        bashrc.write_text(new_text, encoding="utf-8")

    @staticmethod
    def remove_block(
        home: pathlib.Path,
    ) -> None:
        """Remove the dotfiles managed block from ~/.bashrc, if present."""

        bashrc = home / ".bashrc"

        if not bashrc.exists():
            return

        pattern = rf"{re.escape(Bashrc.BLOCK_BEGIN)}.*?{re.escape(Bashrc.BLOCK_END)}"

        text = bashrc.read_text(encoding="utf-8")
        match = re.search(pattern, text, flags=re.DOTALL)

        if match is None:
            return

        # Collapse the newlines surrounding the removed block down to a single
        # boundary. This avoids both merging adjacent content lines (when the
        # block sits between two lines) and leaving a doubled blank line (when
        # the block was appended at EOF).
        before = text[: match.start()].rstrip("\n")
        after = text[match.end() :].lstrip("\n")

        if before and after:
            new_text = f"{before}\n{after}"
        else:
            new_text = before + after

        if new_text and not new_text.endswith("\n"):
            new_text += "\n"

        bashrc.write_text(new_text, encoding="utf-8")


def require_command(
    name: str,
) -> None:
    """Raise SystemExit if the named executable is not found on PATH."""

    if shutil.which(name) is None:
        err_console.print(f"[red]==> command not found: {name}[/red]")
        raise SystemExit(1)


def find_pixi() -> pathlib.Path:
    """Return the pixi binary path, checking ~/.pixi/bin first then PATH."""

    candidate = pathlib.Path.home() / ".pixi" / "bin" / "pixi"

    if candidate.is_file() and os.access(candidate, os.X_OK):
        return candidate

    found = shutil.which("pixi")

    if found:
        return pathlib.Path(found)

    raise RuntimeError("pixi binary not found; cannot install tools")


def find_age() -> pathlib.Path | None:
    """Return the age binary path, checking ~/.pixi/bin first then PATH."""

    candidate = pathlib.Path.home() / ".pixi" / "bin" / "age"
    if candidate.is_file() and os.access(candidate, os.X_OK):
        return candidate

    found = shutil.which("age")
    return pathlib.Path(found) if found else None


def install_tools(
    pixi: pathlib.Path,
) -> None:
    """Install or upgrade each tool in TOOLS via pixi global."""

    console.print("==> Installing tools via pixi global")
    for tool in TOOLS:
        console.print(f"    · {tool}")
        for cmd in ("install", "upgrade"):
            r = subprocess.run(
                [str(pixi), "global", cmd, tool],
                capture_output=True,
                text=True,
            )
            if r.returncode == 0:
                break
        else:
            raise RuntimeError(f"Failed to install/upgrade '{tool}':\n{r.stderr}")


# ==================
# Encrypted dotfiles
# ==================


SECRETS_PREFIX = pathlib.PurePosixPath("secrets/home")
SECRETS_RECIPIENTS = pathlib.Path("secrets/recipients.txt")
AGE_IDENTITY = pathlib.Path(".config/dotfiles/age/identity.txt")


@dataclasses.dataclass(frozen=True)
class SecretSpec:
    """An encrypted Git blob and its deterministic target below HOME."""

    source: pathlib.PurePosixPath
    target: pathlib.Path
    source_blob: str


def _git_bytes(
    dotfiles_dir: pathlib.Path,
    *args: str,
) -> bytes:
    """Run a read-only Git command against the bare repo and return stdout."""

    return subprocess.run(
        ["git", "--git-dir", str(dotfiles_dir), *args],
        check=True,
        capture_output=True,
    ).stdout


def _secret_target(
    source: pathlib.PurePosixPath,
    home: pathlib.Path,
) -> pathlib.Path:
    """Map ``secrets/home/<path>.age`` to a safe target below *home*."""

    try:
        relative = source.relative_to(SECRETS_PREFIX)
    except ValueError as exc:
        raise ValueError(f"Encrypted source is outside {SECRETS_PREFIX}: {source}") from exc

    if (
        source.suffix != ".age"
        or not relative.parts
        or relative == pathlib.PurePosixPath(".age")
        or ".." in relative.parts
    ):
        raise ValueError(f"Invalid encrypted source path: {source}")

    plaintext = pathlib.Path(*relative.parts).with_suffix("")
    target = home / plaintext
    home_resolved = home.resolve()
    target_resolved = target.resolve(strict=False)
    if not target_resolved.is_relative_to(home_resolved):
        raise ValueError(f"Encrypted target escapes HOME: {target}")
    return target


def discover_secrets(
    dotfiles_dir: pathlib.Path,
    home: pathlib.Path,
) -> list[SecretSpec]:
    """Discover encrypted files in HEAD without checking them out into HOME."""

    listing = _git_bytes(
        dotfiles_dir,
        "ls-tree",
        "-r",
        "-z",
        "--name-only",
        "HEAD",
        "--",
        str(SECRETS_PREFIX),
    )
    specs: list[SecretSpec] = []
    for raw in listing.split(b"\0"):
        if not raw:
            continue
        source = pathlib.PurePosixPath(raw.decode("utf-8"))
        if source.suffix != ".age":
            continue
        target = _secret_target(source, home)
        source_blob = (
            _git_bytes(dotfiles_dir, "rev-parse", f"HEAD:{source}")
            .decode("ascii")
            .strip()
        )
        specs.append(SecretSpec(source, target, source_blob))
    return sorted(specs, key=lambda spec: str(spec.source))


def _read_manifest(dotfiles_dir: pathlib.Path) -> dict[str, object]:
    """Read manifest.json, returning an empty manifest when it does not exist."""

    path = dotfiles_dir / "manifest.json"
    if not path.exists():
        return {}
    data = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(data, dict):
        raise RuntimeError(f"Invalid manifest: {path}")
    return data


def _write_manifest_data(
    dotfiles_dir: pathlib.Path,
    manifest: dict[str, object],
) -> None:
    """Write manifest.json atomically."""

    path = dotfiles_dir / "manifest.json"
    fd, tmp_name = tempfile.mkstemp(prefix="manifest.", dir=dotfiles_dir)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            json.dump(manifest, stream, indent=2)
            stream.write("\n")
        os.replace(tmp_name, path)
    except BaseException:
        pathlib.Path(tmp_name).unlink(missing_ok=True)
        raise


def _sha256(content: bytes) -> str:
    return hashlib.sha256(content).hexdigest()


def _remove_empty_parents(path: pathlib.Path, stop: pathlib.Path) -> None:
    """Remove empty parents below *stop*, deepest first."""

    while path != stop and path.is_relative_to(stop):
        try:
            path.rmdir()
        except OSError:
            break
        path = path.parent


def _identity_status(home: pathlib.Path) -> tuple[pathlib.Path, str | None]:
    """Return the age identity path and an error when it is unavailable or unsafe."""

    identity = home / AGE_IDENTITY
    if identity.is_symlink():
        return identity, "must be a regular file, not a symlink"
    if not identity.is_file():
        return identity, "missing"
    mode = stat.S_IMODE(identity.stat().st_mode)
    if mode & 0o077:
        return identity, f"unsafe permissions {mode:04o}; expected 0600"
    return identity, None


def _pending_secret_count(
    dotfiles_dir: pathlib.Path,
    home: pathlib.Path,
) -> int:
    """Return the source count when prerequisites are missing, otherwise zero."""

    specs = discover_secrets(dotfiles_dir, home)
    _, identity_error = _identity_status(home)
    return len(specs) if specs and (find_age() is None or identity_error) else 0


def secret_status(
    dotfiles_dir: pathlib.Path,
    home: pathlib.Path,
) -> int:
    """Report encrypted-source and deployed-target state without decrypting."""

    specs = discover_secrets(dotfiles_dir, home)
    age = find_age()
    identity, identity_error = _identity_status(home)
    manifest = _read_manifest(dotfiles_dir)
    deployed = manifest.get("secrets", {})
    if not isinstance(deployed, dict):
        deployed = {}

    console.print(f"==> age: {age or '[yellow]not found[/yellow]'}")
    console.print(
        f"==> identity: {identity}"
        + (f" [yellow]({identity_error})[/yellow]" if identity_error else "")
    )
    console.print(f"==> encrypted files: {len(specs)}")

    for spec in specs:
        rel = str(spec.target.relative_to(home))
        entry = deployed.get(rel)
        if spec.target.is_symlink() or (
            spec.target.exists() and not spec.target.is_file()
        ):
            state = "modified"
        elif not spec.target.is_file():
            state = "pending" if age is None or identity_error else "missing"
        elif not isinstance(entry, dict):
            state = "unmanaged"
        elif entry.get("plaintext_sha256") != _sha256(spec.target.read_bytes()):
            state = "modified"
        elif entry.get("source_blob") != spec.source_blob:
            state = "stale"
        else:
            state = "current"
        console.print(f"    {state:9} {spec.target}")
    return 0


def _decrypt_secret(
    age: pathlib.Path,
    identity: pathlib.Path,
    ciphertext: bytes,
    source: pathlib.PurePosixPath,
) -> bytes:
    """Decrypt one blob without exposing plaintext in logs."""

    result = subprocess.run(
        [str(age), "--decrypt", "--identity", str(identity)],
        input=ciphertext,
        capture_output=True,
    )
    if result.returncode != 0:
        message = result.stderr.decode(errors="replace").strip()
        raise RuntimeError(f"Failed to decrypt {source}: {message}")
    return result.stdout


def apply_secrets(
    dotfiles_dir: pathlib.Path,
    home: pathlib.Path,
    backup_dir: pathlib.Path,
    *,
    force: bool = False,
    missing_ok: bool = False,
) -> int:
    """Decrypt and atomically deploy all encrypted files from HEAD."""

    specs = discover_secrets(dotfiles_dir, home)
    if not specs:
        return 0

    age = find_age()
    identity, identity_error = _identity_status(home)
    if age is None or identity_error:
        reasons = []
        if age is None:
            reasons.append("age is not installed")
        if identity_error:
            reasons.append(f"{identity}: {identity_error}")
        message = "; ".join(reasons)
        err_console.print(
            f"[yellow]==> {len(specs)} encrypted file(s) pending: {message}[/yellow]"
        )
        for spec in specs:
            err_console.print(f"[yellow]    {spec.target}[/yellow]")
        err_console.print(
            f"[yellow]==> Provision {identity} with mode 0600, then run "
            "'dotfiles secrets apply'.[/yellow]"
        )
        return 0 if missing_ok else 1

    manifest = _read_manifest(dotfiles_dir)
    deployed = manifest.get("secrets", {})
    if not isinstance(deployed, dict):
        deployed = {}

    candidates: dict[SecretSpec, bytes] = {}
    for spec in specs:
        ciphertext = _git_bytes(dotfiles_dir, "show", f"HEAD:{spec.source}")
        candidates[spec] = _decrypt_secret(age, identity, ciphertext, spec.source)

    modified: list[pathlib.Path] = []
    for spec, content in candidates.items():
        rel = str(spec.target.relative_to(home))
        checked_out = manifest.get("checked_out", [])
        if isinstance(checked_out, list) and rel in checked_out:
            raise RuntimeError(
                f"Encrypted target collides with a public dotfile: {spec.target}"
            )
        if spec.target.is_symlink():
            raise RuntimeError(f"Secret target is a symlink: {spec.target}")
        if not spec.target.exists():
            continue
        if not spec.target.is_file():
            raise RuntimeError(f"Secret target is not a regular file: {spec.target}")
        entry = deployed.get(rel)
        current = spec.target.read_bytes()
        if current == content:
            continue
        if isinstance(entry, dict) and entry.get("plaintext_sha256") != _sha256(current):
            modified.append(spec.target)

    if modified and not force:
        paths = "\n".join(f"  {path}" for path in modified)
        raise RuntimeError(
            "Refusing to overwrite locally modified secret file(s):\n"
            f"{paths}\nRe-run with --force to replace them."
        )

    originals: dict[pathlib.Path, tuple[bytes, int] | None] = {}
    created_dirs: list[pathlib.Path] = []
    created_backups: list[pathlib.Path] = []
    created_backup_dirs: list[pathlib.Path] = []
    new_entries = dict(deployed)
    try:
        for spec, content in candidates.items():
            target = spec.target
            rel_path = target.relative_to(home)
            rel = str(rel_path)
            entry = deployed.get(rel)
            originals[target] = (
                (target.read_bytes(), stat.S_IMODE(target.stat().st_mode))
                if target.is_file()
                else None
            )

            if target.exists() and rel not in deployed:
                backup = backup_dir / rel_path
                if not backup.exists():
                    missing_backup_parents = [
                        parent
                        for parent in reversed(backup.parents)
                        if parent.is_relative_to(backup_dir)
                        and not parent.exists()
                    ]
                    for parent in missing_backup_parents:
                        parent.mkdir(mode=0o700)
                        created_backup_dirs.append(parent)
                    shutil.copy2(target, backup)
                    created_backups.append(backup)

            missing_parents = [
                parent
                for parent in reversed(target.parents)
                if parent != home and parent.is_relative_to(home) and not parent.exists()
            ]
            for parent in missing_parents:
                parent.mkdir(mode=0o700)
                created_dirs.append(parent)

            fd, tmp_name = tempfile.mkstemp(prefix=f".{target.name}.", dir=target.parent)
            try:
                with os.fdopen(fd, "wb") as stream:
                    stream.write(content)
                os.chmod(tmp_name, 0o600)
                os.replace(tmp_name, target)
            except BaseException:
                pathlib.Path(tmp_name).unlink(missing_ok=True)
                raise

            new_entries[rel] = {
                "source": str(spec.source),
                "source_blob": spec.source_blob,
                "plaintext_sha256": _sha256(content),
                "backed_up": (backup_dir / rel_path).exists(),
                "created_dirs": sorted(
                    {
                        *(
                            entry.get("created_dirs", [])
                            if isinstance(entry, dict)
                            and isinstance(entry.get("created_dirs"), list)
                            else []
                        ),
                        *(
                            str(directory.relative_to(home))
                            for directory in created_dirs
                            if target.is_relative_to(directory)
                        ),
                    }
                ),
            }

        manifest["secrets"] = new_entries
        _write_manifest_data(dotfiles_dir, manifest)
    except BaseException:
        for target, original in reversed(list(originals.items())):
            if original is None:
                target.unlink(missing_ok=True)
            else:
                content, mode = original
                target.parent.mkdir(parents=True, exist_ok=True)
                target.write_bytes(content)
                target.chmod(mode)
        for directory in reversed(created_dirs):
            with contextlib.suppress(OSError):
                directory.rmdir()
        for backup in reversed(created_backups):
            backup.unlink(missing_ok=True)
        for directory in reversed(created_backup_dirs):
            with contextlib.suppress(OSError):
                directory.rmdir()
        raise

    console.print(f"[green]==> Applied {len(candidates)} encrypted file(s).[/green]")
    return 0


def encrypt_secret(
    source: pathlib.Path,
    repo_root: pathlib.Path,
    home: pathlib.Path,
) -> int:
    """Encrypt one HOME file into ``secrets/home`` in a development clone."""

    source = source.expanduser().resolve()
    home = home.resolve()
    if not source.is_file() or not source.is_relative_to(home):
        raise RuntimeError(f"Source must be a regular file below HOME: {source}")

    recipients = repo_root / SECRETS_RECIPIENTS
    if not recipients.is_file():
        raise RuntimeError(f"Recipients file not found: {recipients}")
    age = find_age()
    if age is None:
        raise RuntimeError("age is not installed")

    relative = source.relative_to(home)
    secrets_root = repo_root / SECRETS_PREFIX
    destination = secrets_root / pathlib.Path(
        f"{relative}.age"
    )
    if destination.is_symlink() or not destination.resolve(strict=False).is_relative_to(
        secrets_root.resolve(strict=False)
    ):
        raise RuntimeError(f"Encrypted destination escapes {secrets_root}: {destination}")
    destination.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp_name = tempfile.mkstemp(prefix=f".{destination.name}.", dir=destination.parent)
    os.close(fd)
    try:
        result = subprocess.run(
            [
                str(age),
                "--encrypt",
                "--armor",
                "--recipients-file",
                str(recipients),
                "--output",
                tmp_name,
                str(source),
            ],
            capture_output=True,
            text=True,
        )
        if result.returncode != 0:
            raise RuntimeError(f"Failed to encrypt {source}: {result.stderr.strip()}")
        os.replace(tmp_name, destination)
    except BaseException:
        pathlib.Path(tmp_name).unlink(missing_ok=True)
        raise
    console.print(f"[green]==> Encrypted {source} -> {destination}[/green]")
    return 0


class RollbackStack:
    """Tracks reversible mutations; executes them in reverse on rollback."""

    def __init__(self) -> None:
        self._stack: list[tuple[str, Callable[[], None]]] = []

    def push(
        self,
        description: str,
        fn: Callable[[], None],
    ) -> None:
        """Register a reversible action with a human-readable description."""

        self._stack.append((description, fn))

    def rollback(self) -> None:
        """Execute all registered actions in reverse order, ignoring individual errors."""

        err_console.print(
            "\n[bold red]An error occurred, rolling back changes...[/bold red]"
        )

        for description, fn in reversed(self._stack):
            err_console.print(f"  ↩ {description}")
            try:
                fn()
            except Exception as exc:
                err_console.print(f"    [red]✗ failed: {describe_error(exc)}[/red]")


# ============
# DotfilesRepo
# ============


@dataclasses.dataclass
class DotfilesRepo:
    """
    Bare git repo living in ``~/.dotfiles`` with HOME as its work-tree.

    Clones the dotfiles repo, configures sparse checkout, and checks out
    tracked files directly into HOME, backing up any pre-existing conflicts.
    """

    repo_uri: dataclasses.InitVar[str]
    overwrite_git_dir: dataclasses.InitVar[bool] = False

    home: pathlib.Path = dataclasses.field(default_factory=pathlib.Path.home)

    dotfiles_dir: pathlib.Path = dataclasses.field(
        default_factory=lambda: pathlib.Path.home() / ".dotfiles"
    )

    backup_dir: pathlib.Path = dataclasses.field(
        default_factory=lambda: pathlib.Path.home() / ".dotfiles_backup"
    )

    repo: git.Repo = dataclasses.field(init=False)

    def __post_init__(
        self,
        repo_uri: str,
        overwrite_git_dir: bool = False,
    ) -> None:
        """Resolve the repo source, optionally remove an existing dotfiles dir, then clone."""

        # Determine the repo source based on the provided URI.
        parsed = urllib.parse.urlparse(repo_uri)
        if parsed.scheme in ("http", "https", "git"):
            repo_source = repo_uri
        elif parsed.scheme in ("file", ""):
            local_path = pathlib.Path(
                parsed.path if parsed.scheme == "file" else repo_uri
            ).resolve()
            # Accept both working-tree repos (.git/ subdir) and bare repos (HEAD at root).
            if not ((local_path / ".git").is_dir() or (local_path / "HEAD").is_file()):
                raise ValueError(f"Not a git repository: {local_path}")
            repo_source = str(local_path)
        else:
            raise ValueError(f"Invalid repo URI: {repo_uri}")

        if self.dotfiles_dir.exists() and not overwrite_git_dir:
            raise RuntimeError(
                f"Dotfiles directory '{self.dotfiles_dir}' already exists"
            )

        if overwrite_git_dir and self.dotfiles_dir.exists():
            if self.dotfiles_dir.is_dir():
                # Guard: refuse to delete a directory that does not look like our
                # bare dotfiles repo (a misconfigured DOTFILES_DIR could point at
                # real user data). A bare git repo always has HEAD and objects/.
                if not self._looks_like_bare_repo(self.dotfiles_dir):
                    raise RuntimeError(
                        f"Refusing to overwrite '{self.dotfiles_dir}': it does not "
                        "look like a dotfiles bare repo (missing HEAD/objects). "
                        "Set DOTFILES_DIR correctly or remove it manually."
                    )
                shutil.rmtree(self.dotfiles_dir)
            else:
                self.dotfiles_dir.unlink()

        self.repo = self.clone(repo_source=repo_source, destination=self.dotfiles_dir)

    @staticmethod
    def _looks_like_bare_repo(path: pathlib.Path) -> bool:
        """Return True if *path* has the on-disk signature of a bare git repo."""

        return (path / "HEAD").is_file() and (path / "objects").is_dir()

    @staticmethod
    def clone(
        repo_source: str,
        destination: pathlib.Path,
    ) -> git.Repo:
        """Clone *repo_source* as a bare repository into *destination* and return it."""

        console.print(f"==> Cloning dotfiles repo from [cyan]{repo_source}[/cyan]")
        subprocess.run(
            ["git", "clone", "--quiet", "--bare", repo_source, str(destination)],
            check=True,
            capture_output=True,
            text=True,
        )
        return git.Repo(str(destination))

    @staticmethod
    def configure_sparse_checkout(
        repo: git.Repo,
    ) -> None:
        """Write sparse-checkout rules and hide untracked files in the work-tree."""

        console.print("==> Configuring sparse checkout")
        cw = repo.config_writer()
        cw.set_value("status", "showUntrackedFiles", "no").release()
        cw.set_value("core", "sparseCheckout", "true").release()

        info_dir = pathlib.Path(repo.git_dir) / "info"
        info_dir.mkdir(parents=True, exist_ok=True)
        (info_dir / "sparse-checkout").write_text(SPARSE_CHECKOUT, encoding="utf-8")

    @staticmethod
    @contextlib.contextmanager
    def _sparse_worktree(
        git_dir: str,
        treeish: str,
    ) -> "contextlib.AbstractContextManager[tuple[pathlib.Path, list[pathlib.Path]]]":
        """
        Check out the sparse set of *treeish* into a throwaway work-tree and
        yield ``(worktree_path, files)`` where *files* are the relative paths
        git actually wrote (i.e. the effective sparse set, honoring the
        sparse-checkout rules).

        An isolated index (``GIT_INDEX_FILE``) is used so this never mutates the
        repo's shared index. The listing is derived from what git wrote to disk
        rather than ``git ls-files -t``: the skip-worktree bits are not populated
        on the first ``read-tree``, yet excluded files are already correctly
        withheld from the work-tree.
        """

        with tempfile.TemporaryDirectory(prefix="dotfiles-co-") as tmp:
            tmp_path = pathlib.Path(tmp)
            worktree = tmp_path / "worktree"
            worktree.mkdir()
            env = {**os.environ, "GIT_INDEX_FILE": str(tmp_path / "index")}
            subprocess.run(
                [
                    "git",
                    "--git-dir",
                    git_dir,
                    "--work-tree",
                    str(worktree),
                    "read-tree",
                    "--reset",
                    "-u",
                    treeish,
                ],
                check=True,
                capture_output=True,
                text=True,
                env=env,
            )
            files = sorted(
                p.relative_to(worktree)
                for p in worktree.rglob("*")
                if p.is_file() or p.is_symlink()
            )
            yield worktree, files

    @staticmethod
    def _copy_into_home(
        worktree: pathlib.Path,
        files: list[pathlib.Path],
        home: pathlib.Path,
    ) -> None:
        """Copy *files* from *worktree* into *home*, overwriting existing entries.

        Only the listed (included) files are written, so files already present in
        HOME but NOT in the list — e.g. the user's own ``~/.bashrc`` (which is not
        tracked; we only inject a managed block into it) — are never removed. This
        is why the checkout copies from a throwaway work-tree instead of running
        ``read-tree -u`` directly against HOME: a second ``read-tree -u`` flips
        skip-worktree bits and deletes such excluded files.
        """

        for rel in files:
            src = worktree / rel
            dst = home / rel
            dst.parent.mkdir(parents=True, exist_ok=True)
            if dst.is_symlink() or (dst.exists() and not dst.is_dir()):
                dst.unlink()
            elif dst.is_dir():
                shutil.rmtree(dst)
            shutil.copy2(src, dst, follow_symlinks=False)

    @staticmethod
    def _populate_index(
        git_dir: str,
        home: pathlib.Path,
        checked_out: list[pathlib.Path],
    ) -> None:
        """Populate the shared index from HEAD so ``dotfiles git`` works.

        Uses ``read-tree --reset HEAD`` WITHOUT ``-u`` so the work-tree is never
        touched (no risk of deleting sparse-excluded files in HOME), then marks
        every sparse-excluded tracked file ``--skip-worktree`` so that
        ``dotfiles git status`` ignores them and ``dotfiles git commit -a`` never
        stages their (spurious) deletion.
        """

        subprocess.run(
            [
                "git",
                "--git-dir",
                git_dir,
                "--work-tree",
                str(home),
                "read-tree",
                "--reset",
                "HEAD",
            ],
            check=True,
            capture_output=True,
            text=True,
        )

        listed = subprocess.run(
            ["git", "--git-dir", git_dir, "ls-files"],
            check=True,
            capture_output=True,
            text=True,
        )
        included = {str(p) for p in checked_out}
        excluded = [
            line for line in listed.stdout.splitlines() if line and line not in included
        ]

        if excluded:
            DotfilesRepo._mark_skip_worktree(git_dir, home, excluded)
            # A sparse-excluded file the user already has in HOME collides with
            # the tracked blob at the same path. The realistic case is their own
            # ~/.gitattributes (or ~/.gitignore): those live at the exact path of
            # the tracked repo-internal file because the bare-repo work-tree is
            # HOME. Modern git (>= 2.53) refuses to set skip-worktree on a path
            # that is present and differs from the index, so such a file would
            # show up as modified forever. Mark the collisions --assume-unchanged
            # so `dotfiles git status` stays clean and `commit -a` never stages
            # the user's own content.
            collisions = [p for p in excluded if (home / p).exists()]
            if collisions:
                DotfilesRepo._mark_assume_unchanged(git_dir, home, collisions)

    @staticmethod
    def _mark_skip_worktree(
        git_dir: str,
        home: pathlib.Path,
        paths: list[str],
    ) -> None:
        """Mark *paths* ``--skip-worktree`` in the shared index, best effort.

        The skip-worktree bits are a nicety on top of ``core.sparseCheckout``:
        recent git already hides sparse-excluded files from ``git status``, and
        this marking only keeps that behaviour correct on older git.
        """

        DotfilesRepo._update_index_flag(
            git_dir, home, "--skip-worktree", paths, "skip-worktree"
        )

    @staticmethod
    def _mark_assume_unchanged(
        git_dir: str,
        home: pathlib.Path,
        paths: list[str],
    ) -> None:
        """Mark *paths* ``--assume-unchanged`` in the shared index, best effort.

        Used as a fallback for sparse-excluded files the user already has in
        HOME: modern git will not set skip-worktree on a present, differing
        path, so assume-unchanged is what actually keeps ``dotfiles git status``
        clean for those collisions.
        """

        DotfilesRepo._update_index_flag(
            git_dir, home, "--assume-unchanged", paths, "assume-unchanged"
        )

    @staticmethod
    def _update_index_flag(
        git_dir: str,
        home: pathlib.Path,
        flag: str,
        paths: list[str],
        label: str,
    ) -> None:
        """Run ``update-index <flag>`` on *paths*, best effort.

        A failure here must never abort (and roll back) an otherwise successful
        checkout, so a single batch that returns non-zero is retried file by
        file and the few paths git refuses to mark are reported as a warning
        instead of raising.
        """

        base = ["git", "--git-dir", git_dir, "--work-tree", str(home)]
        batch = subprocess.run(
            [*base, "update-index", flag, "--", *paths],
            check=False,
            capture_output=True,
            text=True,
        )
        if batch.returncode == 0:
            return

        # The batch stops at the first path git cannot mark, so retry each path
        # on its own to skip only the offending entries.
        failed: list[str] = []
        for path in paths:
            single = subprocess.run(
                [*base, "update-index", flag, "--", path],
                check=False,
                capture_output=True,
                text=True,
            )
            if single.returncode != 0:
                failed.append(path)

        if failed:
            console.print(
                "==> [yellow]Warning:[/yellow] could not mark "
                f"{len(failed)} file(s) {label}: {', '.join(failed)}"
            )

    @staticmethod
    def checkout_to_home(
        repo: git.Repo,
        home: pathlib.Path,
        backup_dir: pathlib.Path,
        managed: frozenset[pathlib.Path] = frozenset(),
    ) -> tuple[list[pathlib.Path], list[pathlib.Path]]:
        """
        Check out the sparse set of tracked files into home, backing up any
        pre-existing conflicts first.

        Returns ``(backed_up, checked_out)`` where ``checked_out`` is the
        effective sparse set (files actually written to HOME) and ``backed_up``
        are the relative paths that have a preserved copy in ``backup_dir``.

        Behaviour:
        - Only files in the effective checkout set are considered for backup, so
          untracked user files in HOME (e.g. the user's own ``~/.bashrc``, into
          which we only inject a managed block) are never touched.
        - Files listed in *managed* (already checked out by a previous run, per
          the manifest) are refreshed in place and NOT backed up — they are our
          own files, not the user's originals.
        - An existing backup entry is never overwritten, so the pristine
          original captured on the first run is preserved across updates.
        - Files are copied from a throwaway sparse work-tree rather than written
          by ``read-tree -u`` against HOME, so excluded files are never deleted.
        """

        git_dir = str(repo.git_dir)

        with DotfilesRepo._sparse_worktree(git_dir, "HEAD") as (worktree, checked_out):
            # Back up genuine user conflicts only: skip managed files, and never
            # overwrite an already-captured backup.
            conflicts = [
                rel
                for rel in checked_out
                if rel not in managed
                and ((home / rel).exists() or (home / rel).is_symlink())
            ]
            to_backup = [rel for rel in conflicts if not (backup_dir / rel).exists()]

            if to_backup:
                console.print(
                    f"==> Backing up [yellow]{len(to_backup)}[/yellow] pre-existing file(s) to [cyan]{backup_dir}[/cyan]"
                )
                backup_dir.mkdir(parents=True, exist_ok=True)
                for rel in to_backup:
                    dst = backup_dir / rel
                    dst.parent.mkdir(parents=True, exist_ok=True)
                    shutil.move(str(home / rel), str(dst))

            console.print("==> Checking out dotfiles into home")
            DotfilesRepo._copy_into_home(worktree, checked_out, home)

        # Populate the shared index so `dotfiles git <cmd>` works against HOME.
        DotfilesRepo._populate_index(git_dir, home, checked_out)

        backed_up = [rel for rel in checked_out if (backup_dir / rel).exists()]

        return backed_up, checked_out


# ========================
# Manifest + notifications
# ========================


def write_manifest(
    dotfiles_dir: pathlib.Path,
    backup_dir: pathlib.Path,
    backed_up: list[pathlib.Path],
    checked_out: list[pathlib.Path],
) -> None:
    """Persist a JSON manifest recording which files were checked out and backed up."""

    previous = _read_manifest(dotfiles_dir)
    manifest: dict[str, object] = {
        "timestamp": datetime.datetime.now(tz=datetime.timezone.utc).isoformat(),
        "backup_dir": str(backup_dir),
        "backed_up": [str(p) for p in backed_up],
        "checked_out": [str(p) for p in checked_out],
    }
    if isinstance(previous.get("secrets"), dict):
        manifest["secrets"] = previous["secrets"]

    _write_manifest_data(dotfiles_dir, manifest)


def notify_backups(
    backed_up: list[pathlib.Path],
    home: pathlib.Path,
    backup_dir: pathlib.Path,
) -> None:
    """Print a rich-formatted notice listing each file that was backed up."""

    if not backed_up:
        return

    console.print()
    console.print(
        "[bold yellow]⚠  The following files were already present and have been backed up:[/bold yellow]"
    )

    for rel in backed_up:
        console.print(f"   [dim]{home / rel}[/dim]  →  [cyan]{backup_dir / rel}[/cyan]")

    console.print()
    console.print(
        "[yellow]Review them and merge any content you want to keep into the tracked versions.[/yellow]"
    )
    console.print()


def _run_git_passthrough(
    dotfiles_dir: pathlib.Path, home: pathlib.Path, git_args: list[str]
) -> int:
    """Run an arbitrary git command against the dotfiles bare repo, with output to the terminal."""
    result = subprocess.run(
        ["git", "--git-dir", str(dotfiles_dir), "--work-tree", str(home), *git_args],
    )
    return result.returncode


def _git_head_sha(dotfiles_dir: pathlib.Path) -> str:
    """Return the commit SHA that HEAD points to, or '' if it cannot be resolved."""

    result = subprocess.run(
        ["git", "--git-dir", str(dotfiles_dir), "rev-parse", "HEAD"],
        capture_output=True,
        text=True,
    )
    return result.stdout.strip() if result.returncode == 0 else ""


def _fetch_remote_tip(
    dotfiles_dir: pathlib.Path,
    branch: str,
) -> tuple[str, str]:
    """Fetch the remote and return ``(target_sha, stderr)``.

    ``git clone --bare`` leaves ``remote.origin.fetch`` empty, so a plain
    ``fetch`` never advances ``refs/heads/*``: it only moves ``FETCH_HEAD``. To
    make ``--update`` actually pull, fetch the current branch (or the remote
    default when HEAD is detached) explicitly and read the fetched tip from
    ``FETCH_HEAD``. The caller moves the local branch ref to it. ``target_sha``
    is ``''`` when the fetch fails.
    """

    args = ["git", "--git-dir", str(dotfiles_dir), "fetch", "origin"]
    if branch:
        args.append(branch)
    fetched = subprocess.run(args, capture_output=True, text=True)
    if fetched.returncode != 0:
        return "", fetched.stderr

    tip = subprocess.run(
        ["git", "--git-dir", str(dotfiles_dir), "rev-parse", "FETCH_HEAD"],
        capture_output=True,
        text=True,
    )
    return (tip.stdout.strip() if tip.returncode == 0 else ""), fetched.stderr


def _warn_update_branch_mismatch(dotfiles_dir: pathlib.Path) -> None:
    """Warn if local HEAD tracks a branch other than the remote's default branch.

    ``--update`` re-checks-out whatever local HEAD resolves to. If the bare repo
    was cloned from a non-default branch, local HEAD may not follow the branch
    that receives the remote's latest changes, so an update could silently
    re-apply an old tree. This is a best-effort guard: any failure (e.g. no
    network, no ``origin`` remote) is ignored.
    """

    try:
        local = subprocess.run(
            ["git", "--git-dir", str(dotfiles_dir), "rev-parse", "--abbrev-ref", "HEAD"],
            capture_output=True,
            text=True,
        ).stdout.strip()

        ls = subprocess.run(
            ["git", "--git-dir", str(dotfiles_dir), "ls-remote", "--symref", "origin", "HEAD"],
            capture_output=True,
            text=True,
        )

        remote_default = ""
        for line in ls.stdout.splitlines():
            if line.startswith("ref:"):
                remote_default = line.split()[1].rsplit("/", 1)[-1]
                break

        if remote_default and local and remote_default != local:
            err_console.print(
                f"[yellow]==> Warning: local HEAD tracks '{local}' but the remote "
                f"default branch is '{remote_default}'.[/yellow]"
            )
            err_console.print(
                "[yellow]    --update follows local HEAD; the remote's latest "
                "changes may live on a different branch.[/yellow]"
            )
    except Exception:
        # The mismatch check is advisory only. It must never break --update.
        pass


def _current_branch(dotfiles_dir: pathlib.Path) -> str:
    """Return the short name of the branch HEAD points to, or '' if detached."""

    result = subprocess.run(
        ["git", "--git-dir", str(dotfiles_dir), "symbolic-ref", "--short", "HEAD"],
        capture_output=True,
        text=True,
    )
    return result.stdout.strip() if result.returncode == 0 else ""


def _local_modifications(
    dotfiles_dir: pathlib.Path,
    home: pathlib.Path,
    base_sha: str,
) -> list[pathlib.Path]:
    """Tracked dotfiles in HOME whose content differs from *base_sha*.

    These are the user's uncommitted edits that the re-checkout would overwrite.
    The comparison uses *base_sha* (HEAD before the fetch) so files that merely
    changed on the remote, but were not touched by the user, are not reported.
    Sparse-excluded files carry a ``skip-worktree`` bit, so they never show up
    as spurious deletions here.
    """

    if not base_sha:
        return []

    result = subprocess.run(
        [
            "git",
            "--git-dir",
            str(dotfiles_dir),
            "--work-tree",
            str(home),
            "diff",
            "--name-only",
            base_sha,
        ],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        return []
    return [pathlib.Path(line) for line in result.stdout.splitlines() if line]


def _discarded_commits(
    dotfiles_dir: pathlib.Path,
    kept_sha: str,
    dropped_sha: str,
) -> list[str]:
    """One-line summaries of commits reachable from *dropped_sha* but not
    *kept_sha*. These are local commits that advancing to the remote tip would
    drop."""

    if not kept_sha or not dropped_sha or kept_sha == dropped_sha:
        return []

    result = subprocess.run(
        [
            "git",
            "--git-dir",
            str(dotfiles_dir),
            "log",
            "--oneline",
            f"{kept_sha}..{dropped_sha}",
        ],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        return []
    return [line for line in result.stdout.splitlines() if line]


def _report_pending_loss(
    worktree_mods: list[pathlib.Path],
    discarded: list[str],
    home: pathlib.Path,
) -> None:
    """Print the local changes a destructive command is about to drop.

    Two independent categories, either of which may be empty:
    - *worktree_mods*: tracked dotfiles in HOME with uncommitted edits. Only
      ``--uninstall`` reports these; ``--update`` autostashes them instead (see
      ``_reapply_stashed``).
    - *discarded*: one-line summaries of local commits not on the remote, which
      ``--update`` would drop.
    """

    err_console.print(
        "\n[bold yellow]⚠  This would discard the following local changes:[/bold yellow]"
    )
    if worktree_mods:
        err_console.print("[yellow]  Uncommitted edits to tracked files:[/yellow]")
        for path in worktree_mods:
            err_console.print(f"    [dim]{path}[/dim]")
    if discarded:
        err_console.print("[yellow]  Local commits not present on the remote:[/yellow]")
        for line in discarded:
            err_console.print(f"    [dim]{line}[/dim]")
    err_console.print()


def _confirm_override(force: bool) -> bool:
    """Ask whether to overwrite local changes; defaults to *no*.

    ``force`` (``--force``) short-circuits to yes. A non-interactive stdin can
    never answer the prompt, so it defaults to no and asks for ``--force``.
    """

    if force:
        return True
    if not sys.stdin.isatty():
        err_console.print(
            "[yellow]==> Non-interactive shell: refusing to discard local changes. "
            "Re-run with --force to override.[/yellow]"
        )
        return False
    try:
        answer = input("Override local changes and lose them? [y/N] ")
    except EOFError:
        return False
    return answer.strip().lower() in {"y", "yes"}


def _snapshot_worktree_files(
    home: pathlib.Path,
    paths: list[pathlib.Path],
) -> dict[pathlib.Path, bytes | None]:
    """Read the current HOME content of *paths* so --update can re-apply the
    user's uncommitted edits after the re-checkout (autostash semantics).

    Read now, before the re-checkout overwrites the files. A path the user has
    locally deleted is recorded as ``None`` so the deletion can be re-applied
    too.
    """

    snapshot: dict[pathlib.Path, bytes | None] = {}
    for rel in paths:
        target = home / rel
        try:
            snapshot[rel] = target.read_bytes() if target.is_file() else None
        except OSError:
            snapshot[rel] = None
    return snapshot


def _remote_changed_paths(
    dotfiles_dir: pathlib.Path,
    pre_sha: str,
    post_sha: str,
) -> set[pathlib.Path]:
    """Tracked paths whose content changed between *pre_sha* and *post_sha*.

    These are the files the pull itself touched, i.e. the ones where a local
    edit collides with an incoming change.
    """

    if not pre_sha or not post_sha or pre_sha == post_sha:
        return set()

    result = subprocess.run(
        [
            "git",
            "--git-dir",
            str(dotfiles_dir),
            "diff",
            "--name-only",
            pre_sha,
            post_sha,
        ],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        return set()
    return {pathlib.Path(line) for line in result.stdout.splitlines() if line}


def _reapply_stashed(
    stashed: dict[pathlib.Path, bytes | None],
    remote_changed: set[pathlib.Path],
    home: pathlib.Path,
    backup_dir: pathlib.Path,
) -> tuple[list[pathlib.Path], list[tuple[pathlib.Path, pathlib.Path]]]:
    """Re-apply the user's autostashed edits after the re-checkout.

    For a file the pull did NOT touch, the edit is written straight back, so the
    working tree looks exactly as it did before the update. If the incoming file
    already equals the stashed edit, the change has converged and needs no
    action. For a genuinely divergent file the pull also changed, the incoming
    version stays in HOME and the user's edit is parked in *backup_dir* under a
    distinct ``.local`` name instead: nothing is lost and no half-merged file
    with conflict markers is ever produced.

    Returns ``(preserved, conflicts)`` where ``conflicts`` pairs each collided
    path with the backup file that now holds the user's edit.
    """

    preserved: list[pathlib.Path] = []
    conflicts: list[tuple[pathlib.Path, pathlib.Path]] = []
    for rel, content in stashed.items():
        target = home / rel
        incoming = target.read_bytes() if target.is_file() else None
        if content == incoming:
            continue
        if rel in remote_changed:
            # Collision: keep the incoming version, park the user's edit under a
            # name that never clobbers the pristine bootstrap backup.
            if content is not None:
                dst = _unique_local_backup(backup_dir, rel)
                dst.parent.mkdir(parents=True, exist_ok=True)
                dst.write_bytes(content)
                conflicts.append((rel, dst))
            continue
        # No incoming change: restore the user's edit verbatim.
        if content is None:
            target.unlink(missing_ok=True)
        else:
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_bytes(content)
        preserved.append(rel)
    return preserved, conflicts


def _unique_local_backup(backup_dir: pathlib.Path, rel: pathlib.Path) -> pathlib.Path:
    """A backup path for a collided local edit that never overwrites an existing
    file (the pristine bootstrap backup lives at ``backup_dir / rel``)."""

    candidate = backup_dir / rel.parent / f"{rel.name}.local"
    counter = 1
    while candidate.exists():
        candidate = backup_dir / rel.parent / f"{rel.name}.local.{counter}"
        counter += 1
    return candidate


def _notify_autostash(
    preserved: list[pathlib.Path],
    conflicts: list[tuple[pathlib.Path, pathlib.Path]],
    home: pathlib.Path,
) -> None:
    """Report which local edits --update kept in place and which it parked."""

    if preserved:
        console.print(
            f"==> [green]Kept {len(preserved)} local edit(s)[/green] across the update:"
        )
        for rel in preserved:
            console.print(f"    [dim]{home / rel}[/dim]")
    if conflicts:
        err_console.print(
            f"\n[bold yellow]⚠  {len(conflicts)} local edit(s) collided with an "
            "incoming change[/bold yellow]"
        )
        err_console.print(
            "[yellow]  The updated version was kept; your edit was saved to:[/yellow]"
        )
        for rel, dst in conflicts:
            err_console.print(f"    [dim]{home / rel}[/dim] -> [cyan]{dst}[/cyan]")
        err_console.print()


# ===========
# Entry point
# ===========


def update(
    dotfiles_dir: pathlib.Path,
    home: pathlib.Path,
    backup_dir: pathlib.Path,
    force: bool = False,
) -> int:
    """Pull latest changes from remote, re-apply sparse-checkout rules, and re-checkout dotfiles.

    Covers two concerns in one command:
    - Keeping dotfiles in sync with the remote repo (feature: dotfiles update).
    - Re-applying sparse-checkout rules after they change in a new version of this script.

    The re-checkout is guarded by a RollbackStack so a mid-way failure restores
    the previous work-tree state and ~/.bashrc instead of leaving HOME
    half-migrated.

    Uncommitted edits to tracked dotfiles are preserved automatically (autostash
    semantics): they are snapshotted before the re-checkout and written back
    after it. An edit that collides with a file the pull also changed is not
    merged; the incoming version wins in HOME and the user's edit is parked in
    ``backup_dir``. The only genuinely destructive case left is a local commit
    that is not on the remote: --update reports it and asks for confirmation
    (default no); ``force`` (``--force``) skips that prompt and drops it.
    """

    if not dotfiles_dir.exists():
        err_console.print(f"[red]==> dotfiles dir not found: {dotfiles_dir}[/red]")
        err_console.print("[red]==> Run without --update first to bootstrap.[/red]")
        return 1

    console.print("==> Pulling latest dotfiles from remote")

    # Capture HEAD before fetching so we can (a) detect a no-op update and
    # (b) restore the previous tree on rollback.
    pre_sha = _git_head_sha(dotfiles_dir)

    # Capture state that the re-checkout would clobber, before touching anything:
    # the branch to restore on abort, and the user's uncommitted edits (measured
    # against pre_sha so remote-only changes are not mistaken for local ones).
    # Snapshot their content now so it can be re-applied after the re-checkout.
    branch = _current_branch(dotfiles_dir)
    worktree_mods = _local_modifications(dotfiles_dir, home, pre_sha)
    stashed = _snapshot_worktree_files(home, worktree_mods)

    # `git pull` requires a work tree and fails on a bare repo. `git clone
    # --bare` also leaves `remote.origin.fetch` empty, so a plain `fetch` only
    # moves FETCH_HEAD, never `refs/heads/*`. Fetch the current branch's remote
    # tip explicitly, decide whether advancing to it would drop any local commit,
    # and only then move the local branch ref (a fast-forward, or a forced drop).
    target_sha, fetch_err = _fetch_remote_tip(dotfiles_dir, branch)
    if not target_sha:
        err_console.print(f"[red]==> git fetch failed:\n{fetch_err}[/red]")
        return 1

    # Local commits that advancing to the remote tip would drop (reachable from
    # pre_sha but not from target_sha). Uncommitted edits are autostashed, so
    # only dropped commits still need consent.
    discarded = _discarded_commits(dotfiles_dir, target_sha, pre_sha)

    if discarded:
        _report_pending_loss([], discarded, home)
        if not _confirm_override(force):
            # HEAD has not moved yet, so aborting needs no ref surgery.
            console.print("[yellow]==> Update aborted; no changes made.[/yellow]")
            return 1

    # Move the local branch to the remote tip. Until this point HEAD still points
    # at pre_sha, so the abort path above leaves the repo exactly as it was.
    if branch and target_sha != pre_sha:
        advanced = subprocess.run(
            [
                "git",
                "--git-dir",
                str(dotfiles_dir),
                "update-ref",
                f"refs/heads/{branch}",
                target_sha,
            ],
            capture_output=True,
            text=True,
        )
        if advanced.returncode != 0:
            err_console.print(
                f"[red]==> failed to advance {branch} to the remote tip:\n"
                f"{advanced.stderr}[/red]"
            )
            return 1

    post_sha = _git_head_sha(dotfiles_dir)

    # Files the pull itself changed, so a local edit to one of them is a genuine
    # collision (handled by _reapply_stashed, not overwritten silently).
    remote_changed = _remote_changed_paths(dotfiles_dir, pre_sha, post_sha)

    # Guards: surface a branch mismatch and distinguish no-op from real updates.
    _warn_update_branch_mismatch(dotfiles_dir)
    if pre_sha and pre_sha == post_sha:
        console.print("[green]==> Already up to date.[/green]")
    else:
        console.print(
            f"[green]==> Updated {pre_sha[:9] or '?'} → {post_sha[:9] or '?'}[/green]"
        )

    repo = git.Repo(str(dotfiles_dir))

    # Files checked out by a previous run are ours to refresh, not user
    # originals, so they must not be backed up again on update.
    managed: frozenset[pathlib.Path] = frozenset()
    manifest_path = dotfiles_dir / "manifest.json"
    if manifest_path.exists():
        with contextlib.suppress(Exception):
            prev = json.loads(manifest_path.read_text(encoding="utf-8"))
            managed = frozenset(pathlib.Path(p) for p in prev.get("checked_out", []))

    rollback = RollbackStack()
    try:
        # Re-apply sparse-checkout rules — handles rule changes in a newly pulled script.
        DotfilesRepo.configure_sparse_checkout(repo=repo)

        bashrc = home / ".bashrc"
        bashrc_original = (
            bashrc.read_text(encoding="utf-8") if bashrc.exists() else None
        )

        def _restore_worktree() -> None:
            # Re-checkout the previous tree via copy (never deletes excluded
            # files such as ~/.bashrc), mirroring checkout_to_home's strategy.
            if not pre_sha:
                return
            with DotfilesRepo._sparse_worktree(str(dotfiles_dir), pre_sha) as (
                worktree,
                files,
            ):
                DotfilesRepo._copy_into_home(worktree, files, home)
            DotfilesRepo._populate_index(str(dotfiles_dir), home, files)
            # Put the user's uncommitted edits back too, so a failed update
            # leaves HOME exactly as it was, autostashed edits included.
            for rel, content in stashed.items():
                target = home / rel
                if content is None:
                    target.unlink(missing_ok=True)
                else:
                    target.parent.mkdir(parents=True, exist_ok=True)
                    target.write_bytes(content)

        def _restore_bashrc() -> None:
            if bashrc_original is None:
                bashrc.unlink(missing_ok=True)
            else:
                bashrc.write_text(bashrc_original, encoding="utf-8")

        # Pushed so rollback runs work-tree restore first, then .bashrc restore.
        rollback.push("restore .bashrc", _restore_bashrc)
        rollback.push("restore work-tree to pre-update state", _restore_worktree)

        backed_up, checked_out = DotfilesRepo.checkout_to_home(
            repo=repo,
            home=home,
            backup_dir=backup_dir,
            managed=managed,
        )

        # Re-apply the autostashed edits over the fresh checkout.
        preserved, conflicts = _reapply_stashed(
            stashed, remote_changed, home, backup_dir
        )

        write_manifest(
            dotfiles_dir=dotfiles_dir,
            backup_dir=backup_dir,
            backed_up=backed_up,
            checked_out=checked_out,
        )

        notify_backups(backed_up, home=home, backup_dir=backup_dir)
        _notify_autostash(preserved, conflicts, home)
        Bashrc.inject(home, Bashrc.read_block(home))
    except Exception as exc:
        err_console.print(f"\n[red]==> {describe_error(exc)}[/red]")
        rollback.rollback()
        return 1

    try:
        secret_result = apply_secrets(
            dotfiles_dir=dotfiles_dir,
            home=home,
            backup_dir=backup_dir,
            missing_ok=True,
        )
    except Exception as exc:
        err_console.print(
            f"\n[red]==> Public update completed, but encrypted files could not "
            f"be refreshed: {describe_error(exc)}[/red]"
        )
        return 1

    pending = _pending_secret_count(dotfiles_dir, home)
    if pending:
        console.print(
            f"[bold yellow]==> Update complete; {pending} encrypted file(s) "
            "remain pending.[/bold yellow]"
        )
    else:
        console.print("[bold green]==> Update complete.[/bold green]")
    return secret_result


def _secret_local_modifications(
    manifest: dict[str, object],
    home: pathlib.Path,
) -> list[pathlib.Path]:
    """Return deployed secrets whose current bytes differ from the manifest."""

    deployed = manifest.get("secrets", {})
    if not isinstance(deployed, dict):
        return []
    modified: list[pathlib.Path] = []
    for rel, entry in deployed.items():
        if not isinstance(rel, str) or not isinstance(entry, dict):
            continue
        target = home / rel
        recorded = entry.get("plaintext_sha256")
        if target.is_symlink() or (
            target.exists() and not target.is_file()
        ):
            modified.append(pathlib.Path(rel))
        elif target.is_file() and recorded != _sha256(target.read_bytes()):
            modified.append(pathlib.Path(rel))
    return modified


def _secret_directory_collisions(
    manifest: dict[str, object],
    home: pathlib.Path,
) -> list[pathlib.Path]:
    """Return secret targets currently occupied by directories."""

    deployed = manifest.get("secrets", {})
    if not isinstance(deployed, dict):
        return []
    return [
        pathlib.Path(rel)
        for rel in deployed
        if isinstance(rel, str) and (home / rel).is_dir()
    ]


def _uninstall_secrets(
    manifest: dict[str, object],
    home: pathlib.Path,
    backup_dir: pathlib.Path,
) -> None:
    """Remove unchanged deployed secrets and restore pristine backups."""

    deployed = manifest.get("secrets", {})
    if not isinstance(deployed, dict):
        return

    console.print("==> Removing decrypted dotfiles")
    created_dirs: set[pathlib.Path] = set()
    for rel, entry in deployed.items():
        if not isinstance(rel, str) or not isinstance(entry, dict):
            continue
        recorded_dirs = entry.get("created_dirs", [])
        if isinstance(recorded_dirs, list):
            created_dirs.update(
                home / path
                for path in recorded_dirs
                if isinstance(path, str)
            )
        rel_path = pathlib.Path(rel)
        target = home / rel_path
        target.unlink(missing_ok=True)
        backup = backup_dir / rel_path
        if backup.exists():
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.move(str(backup), str(target))
            _remove_empty_parents(backup.parent, backup_dir)
    for directory in sorted(created_dirs, key=lambda path: len(path.parts), reverse=True):
        with contextlib.suppress(OSError):
            directory.rmdir()


def uninstall(
    dotfiles_dir: pathlib.Path,
    home: pathlib.Path,
    force: bool = False,
) -> int:
    """Remove checked-out dotfiles and restore backed-up files using manifest.json.

    Removing a tracked dotfile from HOME drops any uncommitted edit the user made
    to it (the backup dir only holds the pristine pre-bootstrap copy), so the same
    override guard as --update applies here before anything is deleted.
    """

    manifest_path = dotfiles_dir / "manifest.json"
    if not manifest_path.exists():
        err_console.print(f"[red]==> manifest not found: {manifest_path}[/red]")
        return 1

    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    backup_dir = pathlib.Path(manifest["backup_dir"])
    checked_out = [pathlib.Path(p) for p in manifest["checked_out"]]
    backed_up = [pathlib.Path(p) for p in manifest["backed_up"]]

    worktree_mods = _local_modifications(dotfiles_dir, home, _git_head_sha(dotfiles_dir))
    secret_mods = _secret_local_modifications(manifest, home)
    secret_directories = _secret_directory_collisions(manifest, home)
    if secret_directories:
        paths = "\n".join(f"  {home / path}" for path in secret_directories)
        err_console.print(
            "[red]==> Refusing to uninstall secret targets occupied by directories:"
            f"\n{paths}[/red]"
        )
        return 1
    pending_loss = [*worktree_mods, *secret_mods]
    if pending_loss:
        _report_pending_loss(pending_loss, [], home)
        if not _confirm_override(force):
            console.print("[yellow]==> Uninstall aborted; no changes made.[/yellow]")
            return 1

    console.print("==> Removing checked-out dotfiles from HOME")
    for rel in checked_out:
        f = home / rel
        if f.is_file() or f.is_symlink():
            f.unlink()

    if backed_up:
        console.print("==> Restoring backed-up files")
        for rel in backed_up:
            src = backup_dir / rel
            dst = home / rel
            if src.exists():
                dst.parent.mkdir(parents=True, exist_ok=True)
                shutil.move(str(src), str(dst))
                console.print(f"   [cyan]{src}[/cyan]  →  [dim]{dst}[/dim]")

    _uninstall_secrets(manifest, home, backup_dir)

    console.print(f"==> Removing dotfiles directory {dotfiles_dir}")
    shutil.rmtree(dotfiles_dir, ignore_errors=True)

    Bashrc.remove_block(home)

    # Remove backup_dir if now empty.
    if backup_dir.exists() and not any(backup_dir.iterdir()):
        backup_dir.rmdir()

    console.print("[bold green]==> Uninstall complete.[/bold green]")
    return 0


def main() -> int:
    """Parse arguments, run the full bootstrap flow, and rollback on any error."""

    home = pathlib.Path.home()
    dotfiles_dir = pathlib.Path(
        os.environ.get("DOTFILES_DIR", home / ".dotfiles")
    ).expanduser()
    backup_dir = pathlib.Path(
        os.environ.get("BACKUP_DIR", home / ".dotfiles_backup")
    ).expanduser()

    # Fast-path: `dotfiles git <args>` — passthrough to the bare repo.
    if len(sys.argv) > 1 and sys.argv[1] == "git":
        return _run_git_passthrough(dotfiles_dir, home, sys.argv[2:])

    # Fast-path: encrypted dotfile management.
    if len(sys.argv) > 1 and sys.argv[1] == "secrets":
        secrets_parser = argparse.ArgumentParser(description="Manage encrypted dotfiles")
        secrets_subparsers = secrets_parser.add_subparsers(dest="command", required=True)
        secrets_subparsers.add_parser("status", help="Show encrypted dotfile state")
        apply_parser = secrets_subparsers.add_parser(
            "apply", help="Decrypt and deploy encrypted dotfiles"
        )
        apply_parser.add_argument(
            "--force",
            action="store_true",
            help="Overwrite locally modified decrypted files",
        )
        encrypt_parser = secrets_subparsers.add_parser(
            "encrypt", help="Encrypt a HOME file from a development clone"
        )
        encrypt_parser.add_argument("source", type=pathlib.Path)
        encrypt_parser.add_argument(
            "--repo-root",
            type=pathlib.Path,
            default=pathlib.Path.cwd(),
            help="Development clone containing secrets/recipients.txt (default: cwd)",
        )
        secrets_args = secrets_parser.parse_args(sys.argv[2:])
        try:
            if secrets_args.command == "status":
                return secret_status(dotfiles_dir, home)
            if secrets_args.command == "apply":
                return apply_secrets(
                    dotfiles_dir,
                    home,
                    backup_dir,
                    force=secrets_args.force,
                )
            return encrypt_secret(
                secrets_args.source,
                secrets_args.repo_root.resolve(),
                home,
            )
        except Exception as exc:
            err_console.print(f"[red]==> {describe_error(exc)}[/red]")
            return 1

    parser = argparse.ArgumentParser(
        description="Bootstrap dotfiles",
        epilog="Use 'dotfiles git <args>' to run git against the bare repo.",
    )

    parser.add_argument(
        "--repo-uri",
        type=str,
        metavar="URI",
        default=os.environ.get("DOTFILES_REPO", None),
        help="URI of the dotfiles repo (file://abs/path, git://, https://); env: DOTFILES_REPO",
    )

    parser.add_argument(
        "--overwrite-git-dir",
        action="store_true",
        help="Overwrite existing dotfiles git directory if it exists",
    )

    parser.add_argument(
        "--uninstall",
        action="store_true",
        help="Remove dotfiles and restore backed-up files using the manifest",
    )

    parser.add_argument(
        "--update",
        action="store_true",
        help="Pull latest changes from remote, re-apply sparse-checkout, re-checkout dotfiles",
    )

    parser.add_argument(
        "--force",
        action="store_true",
        help="With --update, drop local commits without prompting; with --uninstall, proceed without prompting",
    )

    parser.add_argument(
        "--skip-tools",
        action="store_true",
        default=bool(os.environ.get("DOTFILES_SKIP_TOOLS")),
        help="Skip installing the pixi global tools; env: DOTFILES_SKIP_TOOLS",
    )

    args = parser.parse_args()

    if args.uninstall:
        return uninstall(dotfiles_dir=dotfiles_dir, home=home, force=args.force)

    if args.update:
        return update(
            dotfiles_dir=dotfiles_dir,
            home=home,
            backup_dir=backup_dir,
            force=args.force,
        )

    if not args.repo_uri:
        msg = "Missing repo URI, pass --repo-uri or set DOTFILES_REPO environment variable"
        raise argparse.ArgumentError(None, msg)

    require_command("git")

    rollback = RollbackStack()

    try:
        dotfiles = DotfilesRepo(
            repo_uri=args.repo_uri,
            overwrite_git_dir=args.overwrite_git_dir,
        )

        rollback.push(
            description="remove dotfiles dir",
            fn=lambda: shutil.rmtree(dotfiles.dotfiles_dir, ignore_errors=True),
        )

        DotfilesRepo.configure_sparse_checkout(repo=dotfiles.repo)

        backed_up, checked_out = DotfilesRepo.checkout_to_home(
            repo=dotfiles.repo,
            home=dotfiles.home,
            backup_dir=dotfiles.backup_dir,
        )

        # Register rollback: remove checked-out files and restore any backups.
        _home, _backup_dir, _backed_up = dotfiles.home, dotfiles.backup_dir, backed_up

        def _undo_checkout() -> None:
            for rel in checked_out:
                f = _home / rel
                if f.is_file() and not f.is_symlink():
                    f.unlink()
            for rel in _backed_up:
                src, dst = _backup_dir / rel, _home / rel
                if src.exists():
                    dst.parent.mkdir(parents=True, exist_ok=True)
                    shutil.move(str(src), str(dst))

        rollback.push(
            description="restore backed-up files and remove checked-out dotfiles",
            fn=_undo_checkout,
        )

        write_manifest(
            dotfiles_dir=dotfiles.dotfiles_dir,
            backup_dir=dotfiles.backup_dir,
            backed_up=backed_up,
            checked_out=checked_out,
        )

        notify_backups(
            backed_up,
            home=dotfiles.home,
            backup_dir=dotfiles.backup_dir,
        )

        # Inject the dotfiles block into ~/.bashrc, saving state for rollback.
        _bashrc = dotfiles.home / ".bashrc"
        _bashrc_original = (
            _bashrc.read_text(encoding="utf-8") if _bashrc.exists() else None
        )
        Bashrc.inject(dotfiles.home, Bashrc.read_block(dotfiles.home))

        def _restore_bashrc() -> None:
            if _bashrc_original is None:
                _bashrc.unlink(missing_ok=True)
            else:
                _bashrc.write_text(_bashrc_original, encoding="utf-8")

        rollback.push(description="restore .bashrc", fn=_restore_bashrc)

    except Exception as exc:
        err_console.print(f"\n[red]==> {describe_error(exc)}[/red]")
        rollback.rollback()
        return 1

    # Tool installation runs AFTER the rollback-guarded section: the dotfiles are
    # already installed at this point, and leaving (or omitting) pixi global
    # packages is harmless. A transient tool-install failure must therefore NOT
    # roll back a successful dotfiles installation.
    if args.skip_tools:
        console.print("==> Skipping tool installation (--skip-tools)")
    else:
        try:
            install_tools(pixi=find_pixi())
        except Exception as exc:
            err_console.print(
                f"\n[yellow]==> Tool installation failed (dotfiles are still installed): {describe_error(exc)}[/yellow]"
            )
            err_console.print(
                "[yellow]==> Re-run to retry, or install the tools manually via pixi global.[/yellow]"
            )

    try:
        secret_result = apply_secrets(
            dotfiles_dir=dotfiles.dotfiles_dir,
            home=dotfiles.home,
            backup_dir=dotfiles.backup_dir,
            missing_ok=True,
        )
    except Exception as exc:
        err_console.print(
            f"\n[red]==> Dotfiles are installed, but encrypted files could not "
            f"be applied: {describe_error(exc)}[/red]"
        )
        return 1

    pending = _pending_secret_count(dotfiles.dotfiles_dir, dotfiles.home)
    if pending:
        console.print(
            f"[bold yellow]==> Dotfiles installed; {pending} encrypted file(s) "
            "remain pending.[/bold yellow]"
        )
    else:
        console.print("[bold green]==> Done![/bold green]")
    return secret_result


if __name__ == "__main__":
    raise SystemExit(main())
